APP_ENV=production
APP_DEBUG=false
HTTP_PORT=18082

DB_NAME=peanut_admin
DB_USER=peanut_admin
DB_PASS=replace-with-a-random-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-random-root-password
JWT_SECRET=replace-with-at-least-32-random-bytes

# Local image names produced by docker-compose.prod.yml. A registry tag may be
# used later when CI takes over image publication.
PHP_IMAGE=peanut-admin-php:production
NGINX_IMAGE=peanut-admin-nginx:production

# Optional: only set these when the Docker builder must use a proxy. The
# address must be reachable from the builder; never use its 127.0.0.1.
# Docker Desktop users can inspect moby.host-gateway-ip with buildx inspect.
# BUILD_HTTP_PROXY=http://docker-builder-visible-host:7890
# BUILD_HTTPS_PROXY=http://docker-builder-visible-host:7890
# BUILD_ALL_PROXY=http://docker-builder-visible-host:7890
# BUILD_NO_PROXY=localhost,127.0.0.1,::1
