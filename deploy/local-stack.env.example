# Non-secret local listener overrides. Copy selected values into
# .local/stack.env, or point PEANUT_LOCAL_ENV_FILE at another private env file.
# These are registered defaults, not mandatory ports; each clone/worktree may
# choose free alternatives without changing tracked source.
PHP_PORT=20180
VITE_PORT=20181
MOBILE_PORT=20182
REDIS_PORT=20184
PC_PORT=20185
DOCS_PORT=20186
DEV_HTTP_PORT=20187
HTTP_PORT=20190
