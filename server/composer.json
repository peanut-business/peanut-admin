{
    "name": "peanut-business/peanut-admin",
    "description": "Peanut Admin application backend",
    "type": "project",
    "keywords": [
        "admin",
        "scaffold",
        "thinkphp",
        "vue"
    ],
    "homepage": "https://github.com/peanut-business/peanut-admin",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/peanut-opensource/peanut-admin-core-php.git"
        }
    ],
    "license": "proprietary",
    "authors": [
        {
            "name": "花生科技"
        }
    ],
    "require": {
        "php": "^8.3",
        "topthink/framework": "^8.0",
        "topthink/think-orm": "^3.0|^4.0",
        "topthink/think-filesystem": "^2.0|^3.0",
        "firebase/php-jwt": "^7.1",
        "dragonmantank/cron-expression": "^3.3",
        "qiniu/php-sdk": "^7.4",
        "aliyuncs/oss-sdk-php": "^2.4",
        "qcloud/cos-sdk-v5": "^2.5",
        "peanut-admin/core": "0.1.0-alpha.8",
        "symfony/html-sanitizer": "^7.3",
        "composer/semver": "^3.4",
        "opis/json-schema": "^2.6"
    },
    "require-dev": {
        "topthink/think-dumper": "^1.0",
        "topthink/think-trace": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "app\\": "app"
        }
    },
    "config": {
        "preferred-install": "dist"
    },
    "scripts": {
        "post-autoload-dump": [
            "@php think service:discover",
            "@php think vendor:publish"
        ]
    }
}
