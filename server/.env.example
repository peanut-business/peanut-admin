APP_ENV=development
APP_DEBUG=false

# 数据库（键名须与 config/database.php 的 env() 调用一致）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=peanut_admin
DB_USER=peanut_admin
DB_PASS=
DB_PREFIX=pa_

# 仅空库首次安装需要；至少 12 位并同时包含字母和数字，升级时留空。
ADMIN_INITIAL_PASSWORD=

# JWT
JWT_SECRET=change-this-to-a-long-random-string-min-32-chars
JWT_EXPIRE=7200
