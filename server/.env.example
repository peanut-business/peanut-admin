APP_ENV=development
APP_DEBUG=false

# 部署模式：standalone 保持单实例兼容；multi-tenant 要求独立平台初始凭据。
DEPLOYMENT_MODE=standalone

# 数据库（键名须与 config/database.php 的 env() 调用一致）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=peanut_admin
DB_USER=peanut_admin
DB_PASS=
DB_PREFIX=pa_

# 仅空库首次安装/首次多租户前滚需要；邮箱用于默认 Tenant owner，密码至少 12 位并同时包含字母和数字。
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=

# 仅 multi-tenant 空库安装/首次多租户前滚需要；邮箱不得与 ADMIN_INITIAL_EMAIL 相同。
# 密码至少 12 位且必须同时包含字母和数字。两项均不得从管理员凭据派生。
PLATFORM_INITIAL_EMAIL=
PLATFORM_INITIAL_PASSWORD=

# JWT
JWT_SECRET=change-this-to-a-long-random-string-min-32-chars
JWT_EXPIRE=7200

# SaaS Host 平台身份登录标识 HMAC；至少 32 字节，且不得与 JWT/管理员凭据复用。
PLATFORM_IDENTIFIER_HMAC_KEY=

# 多租户登录邮箱的独立 HMAC；至少 32 字节，不得复用 JWT 或平台登录 HMAC。
TENANT_IDENTIFIER_HMAC_KEY=
