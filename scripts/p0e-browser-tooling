#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
PACKAGE_VERSION="0.1.18"
PACKAGE="@playwright/cli@${PACKAGE_VERSION}"
TOOLING_DIR="$ROOT/.local/p0e-browser-cli-${PACKAGE_VERSION}"
CLI="$TOOLING_DIR/playwright-cli"

die() { printf 'p0e-browser-tooling: %s\n' "$*" >&2; exit 1; }

command -v npx >/dev/null 2>&1 || die 'npx is required; install Node.js/npm first'

write_wrapper() {
  mkdir -p "$TOOLING_DIR"
  cat >"$CLI" <<EOF
#!/usr/bin/env bash
set -euo pipefail
exec npx --yes --package ${PACKAGE} playwright-cli "\$@"
EOF
  chmod 0755 "$CLI"
}

check_cli() {
  [[ -x "$CLI" ]] || die "fixed Playwright CLI is missing; run scripts/p0e-browser-tooling install"
  local version
  version="$($CLI --version 2>&1)" || die 'fixed Playwright CLI failed its version check'
  [[ "$version" == *"${PACKAGE_VERSION}"* ]] || die "Playwright CLI version mismatch: ${version}"
  printf 'resource=peanut-admin-p0e-playwright-cli\nversion=%s\npath=%s\nstatus=valid\n' "$version" "$CLI"
}

case "${1:-check}" in
  install)
    write_wrapper
    "$CLI" --version >/dev/null
    check_cli
    ;;
  check)
    check_cli
    ;;
  *)
    die 'usage: scripts/p0e-browser-tooling [install|check]'
    ;;
esac
