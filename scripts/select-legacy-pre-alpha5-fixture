#!/usr/bin/env bash

set -euo pipefail

usage() {
  printf 'Usage: scripts/select-legacy-pre-alpha5-fixture --head <commit> --work-dir /absolute/empty/path\n' >&2
  exit 64
}

die() {
  printf 'select-legacy-pre-alpha5-fixture: %s\n' "$*" >&2
  exit 1
}

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
OLD_VERSION='0.1.0-alpha.2'
OLD_REFERENCE='330e76787ba754e1c7c11c2204c1c7f1e9560bb1'
head_commit=''
work_input=''

while [[ $# -gt 0 ]]; do
  case "$1" in
    --head) [[ $# -ge 2 ]] || usage; head_commit="$2"; shift 2 ;;
    --work-dir) [[ $# -ge 2 ]] || usage; work_input="$2"; shift 2 ;;
    *) usage ;;
  esac
done
[[ -n "$head_commit" && -n "$work_input" ]] || usage
[[ "$work_input" == /* ]] || die 'work-dir must be absolute'
[[ ! -L "$work_input" ]] || die 'work-dir must not be a symlink'
work_parent="$(dirname "$work_input")"
[[ -d "$work_parent" ]] || die "work-dir parent does not exist: $work_parent"
WORK="$(cd "$work_parent" && pwd -P)/$(basename "$work_input")"
if [[ -e "$WORK" ]]; then
  [[ -d "$WORK" ]] || die 'work-dir must be a directory'
  [[ -z "$(find "$WORK" -mindepth 1 -print -quit)" ]] || die 'work-dir must be empty'
else
  mkdir "$WORK"
fi

HEAD_COMMIT="$(git -C "$ROOT" rev-parse "${head_commit}^{commit}")"

for commit in $(git -C "$ROOT" rev-list --first-parent "$HEAD_COMMIT"); do
  composer_json="$(git -C "$ROOT" show "${commit}:server/composer.json" 2>/dev/null)" || continue
  [[ "$(jq -r '.require["peanut-admin/core"] // ""' <<<"$composer_json")" == "$OLD_VERSION" ]] || continue
  [[ "$(jq -r '(.repositories // []) | length' <<<"$composer_json")" == 0 ]] || continue

  composer_lock="$(git -C "$ROOT" show "${commit}:server/composer.lock" 2>/dev/null)" || continue
  lock_identity="$(jq -r '.packages[]? | select(.name == "peanut-admin/core") | [.version, .source.reference, .dist.reference] | @tsv' <<<"$composer_lock")"
  [[ "$lock_identity" == "$OLD_VERSION"$'\t'"$OLD_REFERENCE"$'\t'"$OLD_REFERENCE" ]] || continue
  [[ "$(jq -r '.packages[]? | select(.name == "peanut-admin/core") | (.autoload["psr-4"] | length)' <<<"$composer_lock")" == 10 ]] || continue

  candidate="$WORK/$commit"
  archive="$WORK/$commit.tar"
  mkdir "$candidate"
  git -C "$ROOT" archive --format=tar --output="$archive" "$commit"
  tar -xf "$archive" -C "$candidate"

  if ! php - "$candidate" <<'PHP'
<?php
$root = $argv[1];
$lock = json_decode((string) file_get_contents($root . '/server/composer.lock'), true, 512, JSON_THROW_ON_ERROR);
$allowed = [];
foreach ($lock['packages'] as $package) {
    if (($package['name'] ?? null) === 'peanut-admin/core') {
        $allowed = array_keys($package['autoload']['psr-4'] ?? []);
    }
}
if (count($allowed) !== 10) exit(1);

$requiredHostFiles = [
    'server/app/common/contract/AdminPermissionPolicy.php',
    'server/app/common/service/CoreServiceOverrides.php',
    'server/app/common/service/permission/RegisteredAdminPermissionPolicy.php',
    'server/tests/Productization/AdminPermissionHostTest.php',
];
foreach ($requiredHostFiles as $path) if (!is_file($root . '/' . $path)) exit(1);
$host = (string) file_get_contents($root . '/server/app/common/service/CoreServiceOverrides.php');
$probe = (string) file_get_contents($root . '/server/tests/Productization/AdminPermissionHostTest.php');
if (!str_contains($host, 'PeanutAdmin\\Kernel\\Override\\ServiceOverrideRegistry')
    || !str_contains($probe, 'CoreServiceOverrides::registry()')) exit(1);

$iterator = new RecursiveIteratorIterator(new RecursiveDirectoryIterator($root . '/server', FilesystemIterator::SKIP_DOTS));
foreach ($iterator as $file) {
    if (!$file->isFile() || $file->getExtension() !== 'php') continue;
    $path = str_replace(DIRECTORY_SEPARATOR, '/', $file->getPathname());
    if (str_contains($path, '/vendor/')) continue;
    $content = (string) file_get_contents($path);
    if (preg_match('#(?:vendor/peanut-admin|packages/php|peanut-admin/core/.*/src/)#i', $content)) exit(1);
    preg_match_all('/\b(?:use|new|extends|implements|instanceof)\s+\\\\?(PeanutAdmin\\\\[A-Za-z0-9_\\\\]+)/', $content, $matches);
    foreach ($matches[1] as $class) {
        $public = false;
        foreach ($allowed as $prefix) {
            if (str_starts_with($class . '\\', $prefix)) { $public = true; break; }
        }
        if (!$public) exit(1);
    }
}
PHP
  then
    continue
  fi

  tree="$(git -C "$ROOT" rev-parse "${commit}^{tree}")"
  archive_sha256="$(shasum -a 256 "$archive" | awk '{print $1}')"
  composer_json_sha256="$(git -C "$ROOT" show "${commit}:server/composer.json" | shasum -a 256 | awk '{print $1}')"
  composer_lock_sha256="$(git -C "$ROOT" show "${commit}:server/composer.lock" | shasum -a 256 | awk '{print $1}')"
  jq -n \
    --arg name legacy-pre-alpha5 \
    --arg selection_head "$HEAD_COMMIT" \
    --arg commit "$commit" \
    --arg tree "$tree" \
    --arg archive_sha256 "$archive_sha256" \
    --arg composer_json_sha256 "$composer_json_sha256" \
    --arg composer_lock_sha256 "$composer_lock_sha256" \
    --arg version "$OLD_VERSION" \
    --arg reference "$OLD_REFERENCE" \
    '{schema_version: 1, name: $name, selection: "newest eligible first-parent commit", selection_head: $selection_head, source_commit: $commit, source_tree: $tree, archive_sha256: $archive_sha256, composer_json_sha256: $composer_json_sha256, composer_lock_sha256: $composer_lock_sha256, package: "peanut-admin/core", version: $version, source_reference: $reference, public_psr4_root_count: 10, overlay_files: []}'
  exit 0
done

die "no eligible legacy-pre-alpha5 application tree found from $HEAD_COMMIT first-parent history"
