#!/usr/bin/env python3
"""Validate and resolve direct Peanut Admin 2.x release upgrade transitions."""

from __future__ import annotations

import argparse
import hashlib
import hmac
import json
import re
import sys
from pathlib import Path, PurePosixPath
from typing import Any


REPO_ROOT = Path(__file__).resolve().parent.parent
DEFAULT_REGISTRY = REPO_ROOT / "resources/release-upgrade-transitions.json"
PROTOCOL = "peanut.release-upgrade-transitions.v1"
VERSION_PATTERN = re.compile(r"^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$")
DIGEST_PATTERN = re.compile(r"^[a-f0-9]{64}$")
MIGRATION_PREFIX = PurePosixPath("server/database/migrations")


class PolicyError(RuntimeError):
    pass


def fail(message: str) -> None:
    raise PolicyError(message)


def version(tag: object, field: str) -> tuple[int, int, int]:
    if not isinstance(tag, str):
        fail(f"{field} must be a non-empty vX.Y.Z tag")
    match = VERSION_PATTERN.fullmatch(tag)
    if match is None:
        fail(f"{field} must be a non-empty vX.Y.Z tag")
    parsed = tuple(int(part) for part in match.groups())
    if parsed[0] < 2:
        fail(f"{field} must be a 2.x-or-later tag")
    return parsed


def read_registry(path: Path) -> dict[str, Any]:
    try:
        raw = path.read_text(encoding="utf-8")
    except OSError as exception:
        fail(f"cannot read registry {path}: {exception}")
    if raw.strip() == "":
        fail("registry is empty")
    try:
        registry = json.loads(raw)
    except json.JSONDecodeError as exception:
        fail(f"registry JSON is invalid: {exception}")
    if not isinstance(registry, dict):
        fail("registry root must be an object")
    if (
        registry.get("schema_version") != 1
        or registry.get("protocol") != PROTOCOL
        or registry.get("project_id") != "peanut-admin"
    ):
        fail("registry schema, protocol, or project identity is invalid")
    if "transitions" not in registry or not isinstance(registry["transitions"], list):
        fail("registry transitions must be an array")
    return registry


def release_root(path: Path) -> Path:
    try:
        resolved = path.resolve(strict=True)
    except OSError as exception:
        fail(f"release root is unavailable: {exception}")
    if not resolved.is_dir():
        fail("release root must be a directory")
    return resolved


def migration_path(value: object, index: int, migration_index: int) -> PurePosixPath:
    label = f"transition {index} migration {migration_index}"
    if not isinstance(value, str) or value == "":
        fail(f"{label} path is empty or missing")
    if "\\" in value or "//" in value:
        fail(f"{label} path is not a normalized repository-relative path")
    parsed = PurePosixPath(value)
    if (
        parsed.is_absolute()
        or parsed.as_posix() != value
        or any(part in ("", ".", "..") for part in parsed.parts)
        or parsed.parent != MIGRATION_PREFIX
        or parsed.suffix != ".sql"
    ):
        fail(f"{label} path must name one SQL file directly under {MIGRATION_PREFIX}")
    return parsed


def verify_transition(transition: object, index: int, root: Path) -> dict[str, Any]:
    if not isinstance(transition, dict):
        fail(f"transition {index} must be an object")

    from_tag = transition.get("from")
    to_tag = transition.get("to")
    from_version = version(from_tag, f"transition {index} from")
    to_version = version(to_tag, f"transition {index} to")
    if from_version[0] != to_version[0]:
        fail(f"transition {index} crosses a major version")
    if from_version >= to_version:
        fail(f"transition {index} has the wrong direction")

    backup = transition.get("backup")
    if not isinstance(backup, dict) or backup.get("required") is not True:
        fail(f"transition {index} must require backup.required=true")

    migrations = transition.get("migrations")
    if not isinstance(migrations, list):
        fail(f"transition {index} migrations must be an array")

    seen_paths: set[str] = set()
    verified_migrations: list[dict[str, str]] = []
    for migration_index, migration in enumerate(migrations):
        if not isinstance(migration, dict):
            fail(f"transition {index} migration {migration_index} must be an object")
        relative = migration_path(migration.get("path"), index, migration_index)
        relative_text = relative.as_posix()
        if relative_text in seen_paths:
            fail(f"transition {index} has duplicate migration path {relative_text}")
        seen_paths.add(relative_text)

        expected_digest = migration.get("sha256")
        if not isinstance(expected_digest, str) or DIGEST_PATTERN.fullmatch(expected_digest) is None:
            fail(f"transition {index} migration {migration_index} digest is invalid")
        candidate = root.joinpath(*relative.parts)
        try:
            resolved = candidate.resolve(strict=True)
            resolved.relative_to(root)
        except (OSError, ValueError):
            fail(f"transition {index} migration {migration_index} is missing or outside the release root")
        if not resolved.is_file():
            fail(f"transition {index} migration {migration_index} is not a file")
        actual_digest = hashlib.sha256(resolved.read_bytes()).hexdigest()
        if not hmac.compare_digest(expected_digest, actual_digest):
            fail(f"transition {index} migration {migration_index} digest mismatch")
        verified_migrations.append({"path": relative_text, "sha256": expected_digest})

    return {
        "from": from_tag,
        "to": to_tag,
        "backup": {"required": True},
        "migrations": verified_migrations,
    }


def validate_registry(registry: dict[str, Any], root: Path) -> list[dict[str, Any]]:
    verified: list[dict[str, Any]] = []
    seen_transitions: set[tuple[str, str]] = set()
    for index, transition in enumerate(registry["transitions"]):
        item = verify_transition(transition, index, root)
        identity = (item["from"], item["to"])
        if identity in seen_transitions:
            fail(f"duplicate transition {identity[0]} -> {identity[1]}")
        seen_transitions.add(identity)
        verified.append(item)
    return verified


def emit(payload: dict[str, Any]) -> None:
    print(json.dumps(payload, sort_keys=True, separators=(",", ":")))


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--registry", type=Path, default=DEFAULT_REGISTRY)
    parser.add_argument("--release-root", type=Path, required=True)
    subparsers = parser.add_subparsers(dest="command", required=True)
    subparsers.add_parser("validate")
    resolve_parser = subparsers.add_parser("resolve")
    resolve_parser.add_argument("--from", dest="from_tag", required=True)
    resolve_parser.add_argument("--to", dest="to_tag", required=True)
    args = parser.parse_args()

    registry_path = args.registry.resolve()
    root = release_root(args.release_root)
    registry = read_registry(registry_path)
    transitions = validate_registry(registry, root)

    if args.command == "validate":
        emit({
            "protocol": PROTOCOL,
            "status": "valid",
            "transition_count": len(transitions),
        })
        return 0

    requested_from = version(args.from_tag, "--from")
    requested_to = version(args.to_tag, "--to")
    if requested_from[0] != requested_to[0]:
        fail("requested transition crosses a major version")
    if requested_from >= requested_to:
        fail("requested transition has the wrong direction")
    matches = [
        transition
        for transition in transitions
        if transition["from"] == args.from_tag and transition["to"] == args.to_tag
    ]
    if len(matches) != 1:
        fail(
            f"expected exactly one direct transition {args.from_tag} -> {args.to_tag}, "
            f"found {len(matches)}"
        )
    emit({"protocol": PROTOCOL, "status": "resolved", "transition": matches[0]})
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except PolicyError as exception:
        print(f"release-upgrade-policy: {exception}", file=sys.stderr)
        raise SystemExit(1)
