#!/usr/bin/env bash
set -euo pipefail

die() { printf 'ops-backup-worker: %s\n' "$1" >&2; exit 1; }

[[ $# -eq 1 && "$1" == '--once' ]] || die 'usage: scripts/ops-backup-worker --once'
command -v jq >/dev/null || die 'jq is required'
command -v gzip >/dev/null || die 'gzip is required'
command -v sha256sum >/dev/null || die 'sha256sum is required'

project_root="$(pwd -P)"
[[ -f "$project_root/compose.yaml" && -f "$project_root/server/think" ]] || die 'run from a Peanut Admin deployment root'
[[ -f "$project_root/server/.env" ]] || die 'server/.env is required'
sudo -n grep -Fqx 'PEANUT_DEPLOYMENT_TARGET=production' "$project_root/server/.env" || die 'registered production target is not selected'
sudo -n grep -Fqx 'PEANUT_DATABASE_RESOURCE_ID=peanut-admin-production-bundled-mysql84' "$project_root/server/.env" || die 'registered production database is not selected'

qualification_image="${PEANUT_OPS_WORKER_IMAGE:-}"
qualification_run_options=()
if [[ -n "$qualification_image" ]]; then
  qualification_candidate="${PEANUT_OPS_WORKER_CANDIDATE:-}"
  [[ "$qualification_image" =~ ^peanut-admin-restore-verify-worker:[a-f0-9]{12}$ \
    && "$qualification_candidate" =~ ^[a-f0-9]{40}$ \
    && "${qualification_candidate:0:12}" == "${qualification_image##*:}" ]] \
    || die 'qualification worker identity is invalid'
  image_candidate="$(sudo -n docker image inspect "$qualification_image" \
    --format '{{index .Config.Labels "org.opencontainers.image.revision"}}')"
  [[ "$image_candidate" == "$qualification_candidate" ]] \
    || die 'qualification worker image does not match the fixed candidate'
  export PHP_IMAGE="$qualification_image"
  qualification_run_options=(
    --volume "$project_root/server/.env:/var/www/peanut-admin/server/.env.source:ro"
    --env 'PEANUT_SERVER_ENV_FILE=/var/www/peanut-admin/server/.env.source'
  )
fi

compose=(sudo -n docker compose -f compose.yaml --profile bundled-db)
think=("${compose[@]}" run -T --rm --no-deps "${qualification_run_options[@]}" --entrypoint php php server/think ops-backup:task)
claim_json="$("${think[@]}" claim </dev/null)" || die 'task claim failed'
jq -e '.ok == true' <<<"$claim_json" >/dev/null || die 'task claim was rejected'
if [[ "$(jq -r '.result == null' <<<"$claim_json")" == true ]]; then
  printf 'ops-backup-worker: no queued backup task\n'
  exit 0
fi

task_key="$(jq -r '.result.task_key' <<<"$claim_json")"
backup_reference_key="$(jq -r '.result.backup_reference_key' <<<"$claim_json")"
provider_key="$(jq -r '.result.provider_key' <<<"$claim_json")"
execution_revision="$(jq -r '.result.execution_revision' <<<"$claim_json")"
[[ "$task_key" =~ ^job_[a-f0-9]{32}$ ]] || die 'claimed task key is invalid'
[[ "$backup_reference_key" =~ ^backup_[a-f0-9]{32}$ ]] || die 'claimed backup reference is invalid'
[[ "$provider_key" == 'peanut.paired-db-files' ]] || die 'claimed provider is invalid'
[[ "$execution_revision" =~ ^[1-9][0-9]*$ && "$execution_revision" -ge 2 ]] || die 'claimed execution revision is invalid'

stopped=0
failure_code='OPS_BACKUP_RUNTIME_FAILED'
backup_dir=''
heartbeat_pid=''
worker_pid=$$
stop_heartbeat() {
  if [[ -n "$heartbeat_pid" ]]; then
    kill "$heartbeat_pid" >/dev/null 2>&1 || true
    wait "$heartbeat_pid" >/dev/null 2>&1 || true
    heartbeat_pid=''
  fi
}
resume_stack() {
  if [[ "$stopped" -eq 1 ]]; then
    if "${compose[@]}" start --wait --wait-timeout 120 php cron nginx >/dev/null 2>&1; then
      stopped=0
      return 0
    fi
    return 1
  fi
}
mark_failed() {
  local exit_status="${1:-1}"
  local recovery_failed=0
  trap - ERR INT TERM
  stop_heartbeat
  resume_stack || recovery_failed=1
  "${think[@]}" fail --task-key "$task_key" --revision "$execution_revision" --error-code "$failure_code" </dev/null >/dev/null 2>&1 || true
  if [[ "$recovery_failed" -eq 1 ]]; then
    printf 'ops-backup-worker: CRITICAL application writers could not be restored\n' >&2
  fi
  [[ "$exit_status" -ne 0 ]] || exit_status=1
  exit "$exit_status"
}
heartbeat_once() {
  "${think[@]}" heartbeat --task-key "$task_key" --revision "$execution_revision" </dev/null >/dev/null
}
heartbeat_loop() {
  while sleep 60; do
    heartbeat_once || { kill -TERM "$worker_pid"; return 1; }
  done
}
trap 'mark_failed $?' ERR
trap 'mark_failed 130' INT TERM
heartbeat_once
heartbeat_loop &
heartbeat_pid=$!

release_metadata="$project_root/RELEASE_METADATA.json"
[[ -f "$release_metadata" ]] || release_metadata="$project_root/legal/RELEASE_METADATA.json"
[[ -f "$release_metadata" ]] || { failure_code='OPS_BACKUP_RUNTIME_FAILED'; false; }
if git -C "$project_root" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  source_commit="$(git -C "$project_root" rev-parse HEAD)"
  source_tree="$(git -C "$project_root" rev-parse 'HEAD^{tree}')"
else
  source_commit="$(jq -r '.technical_qualification.final_candidate_commit // ""' "$release_metadata")"
  source_tree="$(jq -r '.technical_qualification.final_candidate_tree // ""' "$release_metadata")"
fi
[[ "$source_commit" =~ ^[a-f0-9]{40}$ && "$source_tree" =~ ^[a-f0-9]{40}$ ]] || { failure_code='OPS_BACKUP_RUNTIME_FAILED'; false; }
release_key="$(jq -r 'if (.version | type) == "string" and (.version | test("^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$")) then "v" + .version else "" end' "$release_metadata")"

mysql_mount="$(sudo -n docker volume inspect peanut-admin_mysql-data --format '{{.Mountpoint}}')"
storage_mount="$(sudo -n docker volume inspect peanut-admin_php-storage --format '{{.Mountpoint}}')"
source_bytes="$(( $(sudo -n du -sb "$mysql_mount" | awk '{print $1}') + $(sudo -n du -sb "$storage_mount" | awk '{print $1}') ))"
required_bytes="$(( source_bytes * 2 + 1073741824 ))"
available_bytes="$(df -PB1 "$project_root" | awk 'NR==2 {print $4}')"
available_inodes="$(df -Pi "$project_root" | awk 'NR==2 {print $4}')"
if [[ ! "$available_bytes" =~ ^[0-9]+$ || ! "$available_inodes" =~ ^[0-9]+$ || "$available_bytes" -le "$required_bytes" || "$available_inodes" -le 1024 ]]; then
  failure_code='OPS_BACKUP_CAPACITY_INSUFFICIENT'
  false
fi

backup_id="$(date -u +%Y%m%dT%H%M%SZ)-${source_commit:0:12}"
backup_dir="$project_root/backups/$backup_id"
sudo -n install -d -m 0700 "$project_root/backups"
sudo -n mkdir -m 0700 -- "$backup_dir"

image_json='[]'
for row in 'php peanut-admin-php-1' 'nginx peanut-admin-nginx-1' 'mysql peanut-admin-mysql-1'; do
  role="${row%% *}"; container="${row#* }"
  reference="$(sudo -n docker inspect "$container" --format '{{.Config.Image}}')"
  digest="$(sudo -n docker inspect "$container" --format '{{.Image}}')"
  [[ "$digest" =~ ^sha256:[a-f0-9]{64}$ ]] || { failure_code='OPS_BACKUP_RUNTIME_FAILED'; false; }
  image_json="$(jq -c --arg role "$role" --arg reference "$reference" --arg digest "$digest" '. + [{role:$role,reference:$reference,digest:$digest}]' <<<"$image_json")"
done

started_at="$(date -u +%Y-%m-%dT%H:%M:%S.%3NZ)"
stopped=1
if ! "${compose[@]}" stop --timeout 60 nginx cron php >/dev/null; then
  failure_code='OPS_BACKUP_QUIESCENCE_FAILED'
  false
fi
running_services="$("${compose[@]}" ps --status running --services | sort)"
[[ "$running_services" == mysql ]] || { failure_code='OPS_BACKUP_QUIESCENCE_FAILED'; false; }

failure_code='OPS_BACKUP_DATABASE_FAILED'
"${compose[@]}" exec -T mysql sh -c 'MYSQL_PWD="$MYSQL_ROOT_PASSWORD" exec mysqldump --single-transaction --quick --routines --events --triggers --hex-blob --set-gtid-purged=OFF -uroot peanut_admin' \
  | gzip -9 | sudo -n tee "$backup_dir/database.sql.gz" >/dev/null

failure_code='OPS_BACKUP_FILES_FAILED'
sudo -n tar --one-file-system --numeric-owner -C "$storage_mount" -czf "$backup_dir/php-storage.tar.gz" .
completed_at="$(date -u +%Y-%m-%dT%H:%M:%S.%3NZ)"

database_bytes="$(sudo -n stat -c %s "$backup_dir/database.sql.gz")"
files_bytes="$(sudo -n stat -c %s "$backup_dir/php-storage.tar.gz")"
database_sha="$(sudo -n sha256sum "$backup_dir/database.sql.gz" | awk '{print $1}')"
files_sha="$(sudo -n sha256sum "$backup_dir/php-storage.tar.gz" | awk '{print $1}')"

failure_code='OPS_BACKUP_MANIFEST_INVALID'
jq -c -n \
  --arg backup_reference_key "$backup_reference_key" \
  --arg provider_key "$provider_key" \
  --arg commit "$source_commit" --arg tree "$source_tree" --arg release_key "$release_key" \
  --arg started_at "$started_at" --arg completed_at "$completed_at" \
  --argjson source_bytes "$source_bytes" --argjson required_bytes "$required_bytes" \
  --argjson available_bytes "$available_bytes" --argjson available_inodes "$available_inodes" \
  --argjson images "$image_json" \
  --argjson database_bytes "$database_bytes" --arg database_sha "$database_sha" \
  --argjson files_bytes "$files_bytes" --arg files_sha "$files_sha" \
  '{schema_version:1,backup_reference_key:$backup_reference_key,provider_key:$provider_key,
    source:{commit:$commit,tree:$tree,release_key:(if $release_key=="" then null else $release_key end)},
    resources:{deployment:"peanut-admin-production-deployment",database:"peanut-admin-production-bundled-mysql84",application:"peanut-admin-production-application-containers",backup:"peanut-admin-production-backups"},
    runtime:{compose_project:"peanut-admin",compose_file:"compose.yaml",compose_profile:"bundled-db",database_name:"peanut_admin",storage_volume:"peanut-admin_php-storage",images:$images},
    consistency_window:{mode:"application-write-quiescence",started_at:$started_at,completed_at:$completed_at},
    capacity_preflight:{source_bytes:$source_bytes,required_bytes:$required_bytes,available_bytes:$available_bytes,available_inodes:$available_inodes},
    artifacts:[{kind:"database",filename:"database.sql.gz",bytes:$database_bytes,sha256:$database_sha},{kind:"files",filename:"php-storage.tar.gz",bytes:$files_bytes,sha256:$files_sha}],
    responsibility:{retention_owner:"peanut.production-deployment",cleanup_owner:"peanut.production-deployment",restore_owner:"peanut.production-recovery"}}' \
  | sudo -n tee "$backup_dir/manifest.json" >/dev/null

failure_code='OPS_BACKUP_INTEGRITY_FAILED'
sudo -n bash -c 'cd "$1" && sha256sum database.sql.gz php-storage.tar.gz manifest.json > SHA256SUMS && sha256sum -c SHA256SUMS >/dev/null && gzip -t database.sql.gz && tar -tzf php-storage.tar.gz >/dev/null' bash "$backup_dir"
resume_stack
curl -fsS http://127.0.0.1:18092/healthz >/dev/null

stop_heartbeat
sudo -n cat "$backup_dir/manifest.json" | "${think[@]}" succeed --task-key "$task_key" --revision "$execution_revision" >/dev/null
trap - ERR INT TERM
printf 'ops-backup-worker: succeeded task=%s backup_reference=%s\n' "$task_key" "$backup_reference_key"
