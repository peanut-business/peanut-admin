#!/usr/bin/env python3
"""Check and project Peanut Admin documentation governance without dependencies."""

from __future__ import annotations

import argparse
import fnmatch
import json
import os
from pathlib import Path
import re
import subprocess
import sys


ROOT = Path(__file__).resolve().parent.parent
REGISTRY_PATH = ROOT / "docs/document-registry.json"
IMPACT_PATH = ROOT / "docs/document-impact-map.json"
GENERATED_NOTICE = "<!-- GENERATED: source=docs/document-registry.json; command=./scripts/docs-governance generate -->"
INCLUDE_PATTERN = re.compile(r"<!--\s*@include:\s*([^>\r\n]+?)\s*-->")
REPO_PATH_PATTERN = re.compile(
    r"(?<![\w./-])(?:\./)?(?:scripts|server|web|platform|pc|uniapp|docs|resources|plugins|scaffold)/"
    r"[A-Za-z0-9_.+@{}<>/-]+|(?<![\w./-])release-versions\.json"
)
PUBLIC_INCLUDE_MAX_DEPTH = 32
PUBLIC_INCLUDE_MAX_FILES = 256
PUBLIC_ROUTE_EXEMPTIONS = {"docs-site/404.md"}
PATH_PLACEHOLDER_SEGMENTS = {"acme", "example", "sample", "foo", "bar"}
IMPACT_CLASSIFICATIONS = {
    "none",
    "technical",
    "developer-site",
    "generated",
    "architecture-decision",
}


def load_json(path: Path) -> dict:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise SystemExit(f"ERROR: cannot read {path.relative_to(ROOT)}: {exc}") from exc


def tracked_markdown() -> list[str]:
    result = subprocess.run(
        ["git", "ls-files", "--cached", "--others", "--exclude-standard", "docs", "docs-site"],
        cwd=ROOT,
        check=True,
        capture_output=True,
        text=True,
    )
    return sorted(path for path in result.stdout.splitlines() if path.endswith(".md"))


def render_catalog(registry: dict) -> str:
    lines = [
        GENERATED_NOTICE,
        "# Document catalog",
        "",
        "This catalog is a view of `docs/document-registry.json`; edit the registry and regenerate it.",
        "",
        "## Individually governed documents",
        "",
        "| Stable ID | Path | Status | Type | Owner |",
        "| --- | --- | --- | --- | --- |",
    ]
    for doc in sorted(registry["documents"], key=lambda item: item["id"]):
        lines.append(
            f"| `{doc['id']}` | `{doc['path']}` | `{doc['status']}` | "
            f"`{doc['content_type']}` | `{doc['owner']}` |"
        )
    collections = registry.get("collections", [])
    if collections:
        lines.extend([
            "",
            "## Registered collections",
            "",
            "Collections classify homogeneous legacy material. A substantive edit promotes a file to an individual entry.",
            "",
            "| Stable ID | Includes | Status | Type | Visibility |",
            "| --- | --- | --- | --- | --- |",
        ])
        for collection in sorted(collections, key=lambda item: item["id"]):
            includes = "<br>".join(f"`{pattern}`" for pattern in collection["include"])
            lines.append(
                f"| `{collection['id']}` | {includes} | `{collection['status']}` | "
                f"`{collection['content_type']}` | `{collection['visibility']}` |"
            )
    return "\n".join(lines) + "\n"


def render_public_source_map(registry: dict) -> str:
    rows = []
    for doc in sorted(registry["documents"], key=lambda item: item["id"]):
        if "docs-site" not in doc["scope"]:
            continue
        sources = "<br>".join(f"`{source}`" for source in doc["canonical_sources"])
        rows.append(f"| `{doc['id']}` | `{doc['path']}` | {sources} | `{doc['validation']}` |")
    return "\n".join([
        GENERATED_NOTICE,
        "# Documentation source map",
        "",
        "This public-safe index shows where developer pages get their facts. It intentionally excludes internal resource addresses, credentials, candidate evidence and the internal capability ledger.",
        "",
        "| Document ID | Public page | Upstream | Validation |",
        "| --- | --- | --- | --- |",
        *rows,
        "",
        "For maintainer-only facts, use the repository technical documentation and its authoritative source map.",
        "",
    ])


def generated_outputs(registry: dict) -> dict[Path, str]:
    return {
        ROOT / "docs/reference/document-catalog.generated.md": render_catalog(registry),
        ROOT / "docs-site/reference/source-map.generated.md": render_public_source_map(registry),
    }


def generate(check_only: bool) -> list[str]:
    registry = load_json(REGISTRY_PATH)
    errors: list[str] = []
    for path, expected in generated_outputs(registry).items():
        actual = path.read_text(encoding="utf-8") if path.exists() else None
        if actual == expected:
            continue
        if check_only:
            errors.append(f"generated content drift: {path.relative_to(ROOT)}")
        else:
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(expected, encoding="utf-8")
            print(f"generated {path.relative_to(ROOT)}")
    return errors


def resolve_markdown_target(source: Path, raw_target: str) -> bool:
    target = raw_target.split("#", 1)[0].split("?", 1)[0]
    if not target or target.startswith(("http://", "https://", "mailto:", "tel:", "repo://")):
        return True
    if target.startswith("/"):
        relative = target.lstrip("/")
        candidate = ROOT / "docs-site" / relative
    else:
        candidate = source.parent / target
    candidates = [candidate]
    if not str(candidate).endswith(".md"):
        candidates.append(Path(f"{candidate}.md"))
    if candidate.suffix == "":
        candidates.append(candidate / "index.md")
    if target.startswith("/legal/"):
        generated_legal_sources = {
            "LICENSE.txt": "LICENSE",
            "NOTICE.txt": "NOTICE",
            "THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.md",
            "RELEASE_SBOM.spdx.json": "RELEASE_SBOM.spdx.json",
            "CHANGELOG.txt": "CHANGELOG.md",
            "RELEASE_METADATA.json": "RELEASE_METADATA.json",
        }
        source = generated_legal_sources.get(Path(target).name)
        if source:
            candidates.append(ROOT / source)
    return any(path.exists() for path in candidates)


def markdown_links(path: Path) -> list[str]:
    text = path.read_text(encoding="utf-8")
    text = re.sub(r"```.*?```", "", text, flags=re.DOTALL)
    return [match.group(1).strip() for match in re.finditer(r"(?<!!)\[[^\]]+\]\(([^)]+)\)", text)]


def local_includes(path: Path) -> list[tuple[str, Path | None]]:
    """Return local VitePress include references without evaluating the site build."""
    text = path.read_text(encoding="utf-8")
    text = re.sub(r"```.*?```", "", text, flags=re.DOTALL)
    references: list[tuple[str, Path | None]] = []
    for match in INCLUDE_PATTERN.finditer(text):
        raw_target = match.group(1).strip()
        # VitePress accepts an optional line range suffix, e.g. `{1,3}`.
        target = re.sub(r"\{[^{}]*\}\s*$", "", raw_target).strip()
        if not target or target.startswith(("http://", "https://", "//")):
            continue
        candidate = (ROOT / target.lstrip("/")) if target.startswith("/") else path.parent / target
        try:
            candidate = candidate.resolve()
            candidate.relative_to(ROOT.resolve())
        except ValueError:
            references.append((raw_target, None))
            continue
        references.append((raw_target, candidate))
    return references


def public_content_files(root: Path, errors: list[str]) -> list[tuple[Path, Path]]:
    """Expand local includes for one public page with explicit traversal bounds."""
    root = root.resolve()
    files: list[tuple[Path, Path]] = []
    pending: list[tuple[Path, int]] = [(root, 0)]
    visited: set[Path] = set()
    while pending:
        current, depth = pending.pop()
        if current in visited:
            continue
        visited.add(current)
        if len(visited) > PUBLIC_INCLUDE_MAX_FILES:
            root_name = root.relative_to(ROOT).as_posix()
            errors.append(
                f"public include expansion exceeded {PUBLIC_INCLUDE_MAX_FILES} files: {root_name}"
            )
            break
        if not current.is_file():
            root_name = root.relative_to(ROOT).as_posix()
            target_name = current.as_posix()
            errors.append(f"missing local include for public page {root_name}: {target_name}")
            continue
        files.append((root, current))
        if depth >= PUBLIC_INCLUDE_MAX_DEPTH:
            if local_includes(current):
                root_name = root.relative_to(ROOT).as_posix()
                current_name = current.relative_to(ROOT).as_posix()
                errors.append(
                    f"public include expansion exceeded depth {PUBLIC_INCLUDE_MAX_DEPTH}: "
                    f"{root_name} (at {current_name})"
                )
            continue
        for raw_target, candidate in local_includes(current):
            root_name = root.relative_to(ROOT).as_posix()
            if candidate is None:
                errors.append(f"local include escapes repository for public page {root_name}: {raw_target}")
                continue
            if not candidate.is_file():
                errors.append(f"missing local include for public page {root_name}: {raw_target}")
                continue
            pending.append((candidate, depth + 1))
    return files


def markdown_target_path(source: Path, raw_target: str) -> Path | None:
    """Resolve a local Markdown route target, returning only pages in docs-site."""
    target = raw_target.split("#", 1)[0].split("?", 1)[0].strip()
    if not target or target.startswith(("http://", "https://", "mailto:", "tel:", "repo://")):
        return None
    if target.startswith("/"):
        candidate = ROOT / "docs-site" / target.lstrip("/")
    else:
        candidate = source.parent / target
    candidates = [candidate]
    if not str(candidate).endswith(".md"):
        candidates.append(Path(f"{candidate}.md"))
    if candidate.suffix == "":
        candidates.append(candidate / "index.md")
    for item in candidates:
        if not item.is_file() or item.suffix != ".md":
            continue
        try:
            relative = item.resolve().relative_to((ROOT / "docs-site").resolve())
        except ValueError:
            continue
        return ROOT / "docs-site" / relative
    return None


def repo_relative_path_tokens(text: str) -> list[str]:
    """Extract conservative repository path references from public prose/code."""
    tokens: list[str] = []
    for match in REPO_PATH_PATTERN.finditer(text):
        token = match.group(0).strip().removeprefix("./")
        token = token.rstrip(".,;:)]}`")
        if token and token not in tokens:
            tokens.append(token)
    return tokens


def is_placeholder_path(token: str) -> bool:
    for segment in token.rstrip("/").split("/"):
        normalized = segment.strip().lower()
        if not normalized or normalized in {".", ".."}:
            continue
        if normalized in PATH_PLACEHOLDER_SEGMENTS:
            return True
        if any(marker in segment for marker in ("<", ">", "{", "}", "[", "]", "...")):
            return True
        if normalized.startswith(":"):
            return True
    return False


def repository_path_exists(token: str) -> bool:
    candidates = [ROOT / token]
    # Plugin schema references are relative to `server/` in the documented CLI
    # workflow; retain that explicit context without accepting arbitrary fallbacks.
    if token.startswith("resources/"):
        candidates.append(ROOT / "server" / token)
    return any(candidate.is_file() or candidate.is_dir() for candidate in candidates)


def public_path_errors(registry: dict) -> list[str]:
    """Check only explicit repository paths in current/generated public pages."""
    errors: list[str] = []
    public_paths = {
        doc["path"]
        for doc in registry.get("documents", [])
        if "docs-site" in doc.get("scope", [])
        and doc.get("status") in {"current", "generated"}
        and (ROOT / doc["path"]).is_file()
    }
    for relative in sorted(public_paths):
        page = ROOT / relative
        # Include expansion errors are reported by the public-boundary scan. This
        # pass only consumes the files that are available for path inspection.
        scanned_files = public_content_files(page, [])
        seen: set[tuple[Path, str]] = set()
        for public_page, scanned in scanned_files:
            text = scanned.read_text(encoding="utf-8")
            for token in repo_relative_path_tokens(text):
                if token.endswith("/.env") or is_placeholder_path(token):
                    continue
                key = (scanned, token)
                if key in seen:
                    continue
                seen.add(key)
                if repository_path_exists(token):
                    continue
                page_name = public_page.relative_to(ROOT).as_posix()
                scanned_name = scanned.relative_to(ROOT).as_posix()
                suffix = "" if scanned == public_page else f" (included {scanned_name})"
                errors.append(f"missing repository path in public page: {page_name}{suffix}: {token}")
    return errors


def public_route_errors(registry: dict, config: str) -> list[str]:
    """Ensure every current/generated public page is reachable from public roots."""
    errors: list[str] = []
    public_paths = {
        doc["path"]
        for doc in registry.get("documents", [])
        if "docs-site" in doc.get("scope", [])
        and doc.get("status") in {"current", "generated"}
        and (ROOT / doc["path"]).is_file()
    }
    index = ROOT / "docs-site/index.md"
    roots: set[Path] = {index} if index.is_file() else set()
    for target in re.findall(r"link:\s*['\"](/[^'\"]*)['\"]", config):
        resolved = markdown_target_path(index, target)
        if resolved is not None:
            roots.add(resolved)

    reachable: set[str] = set()
    pending = list(roots)
    while pending:
        current = pending.pop()
        if not current.is_file():
            continue
        try:
            relative = current.resolve().relative_to(ROOT.resolve()).as_posix()
        except ValueError:
            continue
        if not relative.startswith("docs-site/") or relative in reachable:
            continue
        reachable.add(relative)
        # Included Markdown is rendered in the public page's route context, so
        # links from those fragments participate in the same reachability graph.
        for _, scanned in public_content_files(current, []):
            for target in markdown_links(scanned):
                resolved = markdown_target_path(current, target)
                if resolved is not None:
                    pending.append(resolved)

    for relative in sorted(public_paths - reachable - PUBLIC_ROUTE_EXEMPTIONS):
        errors.append(f"unreachable public docs-site page: {relative}")
    return errors


def public_exclusion_errors(registry: dict, config: str) -> list[str]:
    """Keep docs-site lifecycle and VitePress route exposure in lockstep."""
    match = re.search(r"srcExclude\s*:\s*\[(.*?)\]", config, flags=re.DOTALL)
    excluded = set(re.findall(r"['\"]([^'\"]+\.md)['\"]", match.group(1))) if match else set()
    archived = {
        doc["path"].removeprefix("docs-site/")
        for doc in registry.get("documents", [])
        if doc["path"].startswith("docs-site/")
        and doc.get("status") not in {"authoritative", "current", "generated"}
    }
    maintained = {
        doc["path"].removeprefix("docs-site/")
        for doc in registry.get("documents", [])
        if doc["path"].startswith("docs-site/")
        and doc.get("status") in {"authoritative", "current", "generated"}
    }
    errors = [
        f"non-public docs-site page missing from srcExclude: {path}"
        for path in sorted(archived - excluded)
    ]
    errors.extend(
        f"maintained docs-site page must not be in srcExclude: {path}"
        for path in sorted(maintained & excluded)
    )
    errors.extend(
        f"srcExclude page is not registered as non-public: {path}"
        for path in sorted(excluded - archived)
    )
    return errors


def validate_registry(registry: dict) -> list[str]:
    errors: list[str] = []
    required = {
        "id", "path", "title", "audience", "content_type", "authority",
        "canonical_sources", "owner", "status", "scope", "related",
        "site_projections", "replaced_by", "validation",
    }
    allowed = registry.get("enums", {})
    documents = registry.get("documents", [])
    collections = registry.get("collections", [])
    if collections:
        errors.append("collections are not allowed; every Markdown file must have an individual registry entry")
    ids: set[str] = set()
    paths: set[str] = set()
    canonical_keys: set[str] = set()
    by_id: dict[str, dict] = {}
    for doc in documents:
        missing = required - doc.keys()
        if missing:
            errors.append(f"{doc.get('path', '<unknown>')}: missing fields {sorted(missing)}")
            continue
        if doc["id"] in ids:
            errors.append(f"duplicate document id: {doc['id']}")
        ids.add(doc["id"])
        by_id[doc["id"]] = doc
        if doc["path"] in paths:
            errors.append(f"duplicate document path: {doc['path']}")
        paths.add(doc["path"])
        key = doc.get("canonical_key")
        if doc["status"] == "authoritative" and (not isinstance(key, str) or not key.strip()):
            errors.append(f"{doc['id']}: authoritative document requires a non-empty canonical_key")
        if key and key in canonical_keys:
            errors.append(f"duplicate canonical source key: {key}")
        if key:
            canonical_keys.add(key)
        file_path = ROOT / doc["path"]
        if not file_path.is_file():
            errors.append(f"registered document missing: {doc['path']}")
        for enum_name, field in (("audience", "audience"), ("scope", "scope")):
            invalid = set(doc[field]) - set(allowed.get(enum_name, []))
            if invalid:
                errors.append(f"{doc['id']}: invalid {field}: {sorted(invalid)}")
        for enum_name, field in (("content_type", "content_type"), ("status", "status")):
            if doc[field] not in allowed.get(enum_name, []):
                errors.append(f"{doc['id']}: invalid {field}: {doc[field]}")
        for source in doc["canonical_sources"]:
            if source.startswith("repo://"):
                continue
            if "/" in source and not (ROOT / source).exists():
                errors.append(f"{doc['id']}: authoritative source missing: {source}")
        for projection_id in doc["site_projections"]:
            if projection_id not in {item.get("id") for item in documents}:
                errors.append(f"{doc['id']}: projection id missing: {projection_id}")
        if doc["replaced_by"] and doc["replaced_by"] not in {item.get("id") for item in documents}:
            errors.append(f"{doc['id']}: replacement id missing: {doc['replaced_by']}")

    collection_ids: set[str] = set()
    for collection in collections:
        collection_id = collection.get("id")
        if not collection_id or collection_id in ids or collection_id in collection_ids:
            errors.append(f"duplicate or missing collection id: {collection_id}")
        collection_ids.add(collection_id)
        if not collection.get("include"):
            errors.append(f"{collection_id}: collection has no include patterns")

    for path in tracked_markdown():
        if path in paths:
            continue
        matches = [item["id"] for item in collections if any(fnmatch.fnmatch(path, pattern) for pattern in item["include"])]
        if not matches:
            errors.append(f"orphan markdown is not registered: {path}")

    for collection in collections:
        matched = [path for path in tracked_markdown() if any(fnmatch.fnmatch(path, pattern) for pattern in collection["include"])]
        if not matched:
            errors.append(f"empty document collection: {collection['id']}")

    current_paths = {
        doc["path"] for doc in documents
        if doc["status"] in {"authoritative", "current", "generated"}
    }
    current_paths.update(path for path in tracked_markdown() if path.startswith("docs-site/"))
    for relative in sorted(current_paths):
        path = ROOT / relative
        if not path.is_file():
            continue
        for target in markdown_links(path):
            if not resolve_markdown_target(path, target):
                errors.append(f"broken link: {relative} -> {target}")

    config = (ROOT / "docs-site/.vitepress/config.ts").read_text(encoding="utf-8")
    for target in re.findall(r"link:\s*['\"](/[^'\"]*)['\"]", config):
        if not resolve_markdown_target(ROOT / "docs-site/index.md", target):
            errors.append(f"invalid docs-site navigation target: {target}")

    forbidden = {
        "docs/product-status/": "internal product-status path",
        "resources/p0e-runtime-qualification.json": "internal qualification registry",
        "credential reference": "credential reference detail",
        "/Users/": "personal absolute path",
        "192.168.": "private network address",
        "output/playwright": "internal browser evidence",
    }
    for relative in tracked_markdown():
        if not relative.startswith("docs-site/"):
            continue
        path = ROOT / relative
        if not path.is_file():
            continue
        for public_page, scanned in public_content_files(path, errors):
            text = scanned.read_text(encoding="utf-8")
            for needle, label in forbidden.items():
                if needle.lower() not in text.lower():
                    continue
                page_name = public_page.relative_to(ROOT).as_posix()
                scanned_name = scanned.relative_to(ROOT).as_posix()
                suffix = "" if scanned == public_page else f" (included {scanned_name})"
                errors.append(f"forbidden public content ({label}): {page_name}{suffix}")
    errors.extend(public_route_errors(registry, config))
    errors.extend(public_exclusion_errors(registry, config))
    errors.extend(public_path_errors(registry))
    return errors


def match_rules(path: str, impact: dict) -> list[dict]:
    normalized = path.removeprefix("./")
    matched = []
    for rule in impact["rules"]:
        if not any(fnmatch.fnmatch(normalized, pattern) for pattern in rule["paths"]):
            continue
        if any(fnmatch.fnmatch(normalized, pattern) for pattern in rule.get("exclude_paths", [])):
            continue
        matched.append(rule)
    return matched


def impact_for_paths(paths: list[str], impact: dict) -> dict:
    matched: dict[str, dict] = {}
    for path in paths:
        for rule in match_rules(path, impact):
            matched[rule["id"]] = rule
    classifications = sorted({item for rule in matched.values() for item in rule["classifications"]})
    if any(item != "none" for item in classifications):
        classifications = [item for item in classifications if item != "none"]
    return {
        "paths": paths,
        "classifications": classifications or ["none"],
        "rules": sorted(matched),
        "technical_docs": sorted({item for rule in matched.values() for item in rule["technical_docs"]}),
        "site_docs": sorted({item for rule in matched.values() for item in rule["site_docs"]}),
        "generated": sorted({item for rule in matched.values() for item in rule["generated"]}),
    }


def repository_path(value: object) -> bool:
    if not isinstance(value, str):
        return False
    path = value.strip()
    if (
        not path
        or path.startswith(("/", "../", "repo://", "http://", "https://"))
        or any(character in path for character in "*?[]")
    ):
        return False
    candidate = ROOT / path
    return candidate.is_file() or candidate.is_dir()


def split_targets(values: list[object]) -> tuple[list[str], list[str]]:
    required: set[str] = set()
    optional: set[str] = set()
    for target in values:
        explicit_optional = False
        if isinstance(target, dict):
            value = target.get("path", target.get("target"))
            explicit_optional = bool(target.get("optional", False))
        else:
            value = target
        if not isinstance(value, str) or not value.strip():
            continue
        value = value.strip().removeprefix("./")
        (optional if explicit_optional else required).add(value)
    return sorted(required), sorted(optional)


def impact_target_errors(impact: dict, registry: dict) -> list[str]:
    errors: list[str] = []
    registered = {doc["path"]: doc for doc in registry.get("documents", [])}
    for rule in impact.get("rules", []):
        for field in ("technical_docs", "site_docs", "generated"):
            required, _ = split_targets(rule.get(field, []))
            for target in required:
                if not repository_path(target):
                    errors.append(
                        f"rule {rule.get('id', '<unknown>')}: required {field} target missing: {target}"
                    )
                    continue
                document = registered.get(target)
                if document and document.get("status") not in {"authoritative", "current", "generated"}:
                    errors.append(
                        f"rule {rule.get('id', '<unknown>')}: required {field} target is not maintained: "
                        f"{target} ({document.get('status')})"
                    )
    return errors


def impact_closure(paths: list[str], impact: dict, waived_targets: list[str] | None = None) -> dict:
    matched = {rule["id"]: rule for path in paths for rule in match_rules(path, impact)}
    changed = {path.removeprefix("./") for path in paths}
    waived = set(waived_targets or [])
    required: dict[str, list[str]] = {}
    optional: dict[str, list[str]] = {}
    updated: dict[str, list[str]] = {}
    missing: dict[str, list[str]] = {}
    for field in ("technical_docs", "site_docs", "generated"):
        targets = [target for rule in matched.values() for target in rule.get(field, [])]
        required[field], optional[field] = split_targets(targets)
        updated[field] = sorted(set(required[field]) & changed)
        missing[field] = sorted(set(required[field]) - changed - waived)
    return {
        "required_targets": required,
        "updated_targets": updated,
        "optional_targets": optional,
        "missing": missing,
        "waived_targets": sorted(waived),
    }


def closure_errors(closure: dict) -> list[str]:
    errors = []
    for field, targets in closure["missing"].items():
        if targets:
            errors.append(f"missing required {field} target(s): {', '.join(targets)}")
    return errors


def declared_classifications(values: list[str] | None) -> list[str]:
    result: list[str] = []
    for value in values or []:
        for item in value.split(","):
            item = item.strip()
            if item and item not in result:
                result.append(item)
    return result


def changed_paths(base: str) -> list[str]:
    try:
        committed = subprocess.run(
            ["git", "diff", "--name-only", f"{base}...HEAD"],
            cwd=ROOT,
            check=True,
            capture_output=True,
            text=True,
        )
        working_tree = subprocess.run(
            ["git", "diff", "--name-only", base],
            cwd=ROOT,
            check=True,
            capture_output=True,
            text=True,
        )
    except subprocess.CalledProcessError as error:
        raise SystemExit(f"ERROR: unable to compare documentation impact base {base!r}") from error
    return sorted(
        {path for output in (committed.stdout, working_tree.stdout) for path in output.splitlines() if path}
    )


def run_scenarios(impact: dict) -> list[str]:
    errors: list[str] = []
    for scenario in impact["scenarios"]:
        result = impact_for_paths([scenario["path"]], impact)
        classes = set(result["classifications"])
        missing = set(scenario["must_include"]) - classes
        forbidden = set(scenario["must_not_include"]) & classes
        if missing or forbidden:
            errors.append(
                f"scenario {scenario['id']} failed: classes={sorted(classes)}, "
                f"missing={sorted(missing)}, forbidden={sorted(forbidden)}"
            )
    return errors


def report(errors: list[str], success: str) -> int:
    if errors:
        for error in errors:
            print(f"ERROR: {error}", file=sys.stderr)
        return 1
    print(success)
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    subparsers = parser.add_subparsers(dest="command", required=True)
    subparsers.add_parser("check")
    generate_parser = subparsers.add_parser("generate")
    generate_parser.add_argument("--check", action="store_true", dest="check_only")
    impact_parser = subparsers.add_parser("impact")
    impact_parser.add_argument("--base")
    impact_parser.add_argument("--paths", nargs="*")
    impact_parser.add_argument("--classification", action="append", dest="classifications")
    impact_parser.add_argument("--waive-target", action="append", dest="waive_targets", default=[])
    impact_parser.add_argument("--reason")
    subparsers.add_parser("scenarios")
    args = parser.parse_args()

    if args.command == "generate":
        return report(generate(args.check_only), "Generated documentation is current." if args.check_only else "Documentation projections generated.")
    impact = load_json(IMPACT_PATH)
    if args.command == "scenarios":
        return report(run_scenarios(impact), f"Documentation impact scenarios passed: {len(impact['scenarios'])}/8.")
    if args.command == "impact":
        if args.base and args.paths:
            print("ERROR: choose either --base or --paths", file=sys.stderr)
            return 2
        if not args.base and not args.paths:
            print("ERROR: use --paths or --base", file=sys.stderr)
            return 2
        paths = changed_paths(args.base) if args.base else sorted({path.removeprefix("./") for path in args.paths})
        result = impact_for_paths(paths, impact)
        closure = impact_closure(paths, impact)
        requested_waivers = sorted({target.strip().removeprefix("./") for target in args.waive_targets})
        if requested_waivers:
            if not (args.reason or "").strip():
                print("ERROR: --waive-target requires a non-empty --reason", file=sys.stderr)
                return 2
            required_targets = {
                target for targets in closure["required_targets"].values() for target in targets
            }
            invalid = sorted(
                target for target in requested_waivers
                if target not in required_targets or not repository_path(target)
            )
            if invalid:
                print(
                    "ERROR: --waive-target must name an existing required target for this route: "
                    + ", ".join(invalid),
                    file=sys.stderr,
                )
                return 2
            closure = impact_closure(paths, impact, requested_waivers)
        result["waived_targets"] = requested_waivers
        result["waiver_reason"] = args.reason if requested_waivers else None
        declared = declared_classifications(args.classifications)
        mapped = set(result["classifications"])
        invalid = sorted(set(declared) - IMPACT_CLASSIFICATIONS)
        if invalid:
            print(f"ERROR: invalid docs-impact classification(s): {', '.join(invalid)}", file=sys.stderr)
            return 2
        if args.reason is not None and not declared and mapped != {"none"} and not requested_waivers:
            print("ERROR: --reason requires --classification", file=sys.stderr)
            return 2
        if declared:
            if set(declared) != mapped:
                print(
                    "ERROR: declared docs-impact classification(s) must exactly cover "
                    f"mapped classification(s): declared={sorted(declared)} mapped={sorted(mapped)}",
                    file=sys.stderr,
                )
                return 2
            if "none" in declared and (len(declared) != 1 or not (args.reason or "").strip()):
                print("ERROR: docs-impact classification none requires a non-empty reason", file=sys.stderr)
                return 2
            result["declared_classifications"] = declared
            result["declared_classification"] = declared[0] if len(declared) == 1 else declared
            result["reason"] = args.reason
        elif mapped == {"none"}:
            if not (args.reason or "").strip():
                print("ERROR: mapped docs-impact classification none requires a non-empty --reason", file=sys.stderr)
                return 2
            result["reason"] = args.reason
        elif requested_waivers:
            result["reason"] = args.reason
        result["closure"] = closure
        print(json.dumps(result, ensure_ascii=False, indent=2))
        errors = closure_errors(closure)
        if errors:
            for error in errors:
                print(f"ERROR: {error}", file=sys.stderr)
            return 1
        return 0
    registry = load_json(REGISTRY_PATH)
    errors = validate_registry(registry)
    errors.extend(generate(True))
    errors.extend(run_scenarios(impact))
    errors.extend(impact_target_errors(impact, registry))
    return report(errors, "Documentation governance check passed.")


if __name__ == "__main__":
    sys.exit(main())
