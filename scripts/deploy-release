#!/usr/bin/env bash

set -Eeuo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
ROOT_DIR="$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)"
REGISTRY="$ROOT_DIR/resources/project-resources.json"

TAG=""
TARGET=""
MODE=""
APPLY=0
DRY_RUN=0
SSH_ALIAS="oracle3"
REMOTE_ROOT=""
REMOTE_SCRIPT=""
OVERLAY=""
CONFIRM_DESTROY=""
ADMIN_EMAIL="${PEANUT_GENERATED_ADMIN_EMAIL:-}"
ADMIN_PASSWORD="${PEANUT_GENERATED_ADMIN_PASSWORD:-}"
PLATFORM_EMAIL="${PEANUT_GENERATED_PLATFORM_EMAIL:-}"
PLATFORM_PASSWORD="${PEANUT_GENERATED_PLATFORM_PASSWORD:-}"
DEMO_MODE="${PEANUT_DEMO_MODE:-disabled}"
DEMO_TENANT_A_EMAIL="${PEANUT_DEMO_TENANT_A_EMAIL:-}"
DEMO_TENANT_B_EMAIL="${PEANUT_DEMO_TENANT_B_EMAIL:-}"
DEMO_SHARED_PASSWORD="${PEANUT_DEMO_SHARED_PASSWORD:-}"
DEMO_TENANT_A_HOST="${PEANUT_DEMO_TENANT_A_HOST:-}"
DEMO_TENANT_B_HOST="${PEANUT_DEMO_TENANT_B_HOST:-}"
DEMO_DOCS_URL="${PEANUT_DEMO_DOCS_URL:-}"

usage() {
  cat <<'EOF'
Usage: scripts/deploy-release <vX.Y.Z> --target <production|production-candidate> \
  (--fresh | --upgrade) [--apply | --dry-run] [--ssh-alias <alias>] \
  [--overlay <demo-patch.tar>] [--confirm-destroy <target>]

The script deploys an immutable release tag to one registered Peanut Admin
instance. It never guesses a host, path, port, database or fallback target.

  --fresh    install the release into an empty target (destructive for an
             existing target; explicit confirmation is required by --apply)
  --upgrade  preserve the target database/files and run the current migrations
  --dry-run  validate the release and print the exact remote plan only
  --apply    execute the plan over the registered SSH alias
  --overlay  apply a checked demo-only source overlay before building
  --confirm-destroy
             required for --fresh; value must exactly equal the target

The 2.0.0 release is fresh-only with respect to 1.x data. A future 2.0.x
upgrade may use --upgrade after its migration contract is present.
EOF
}

fail() {
  printf 'deploy-release: %s\n' "$1" >&2
  exit 1
}

validate_env_value() {
  local name="$1" value="$2"
  [[ -z "$value" || "$value" =~ ^[A-Za-z0-9@._:/!+=,-]+$ ]] \
    || fail "$name contains characters that cannot be written safely to the deployment .env"
}

if [[ $# -eq 0 ]]; then
  usage >&2
  exit 64
fi
if [[ "$1" == --help || "$1" == -h ]]; then
  usage
  exit 0
fi
TAG="$1"
shift
while [[ $# -gt 0 ]]; do
  case "$1" in
    --target)
      [[ $# -ge 2 ]] || fail '--target requires a value'
      TARGET="$2"; shift 2 ;;
    --fresh) MODE="fresh"; shift ;;
    --upgrade) MODE="upgrade"; shift ;;
    --apply) APPLY=1; shift ;;
    --dry-run) DRY_RUN=1; shift ;;
    --ssh-alias)
      [[ $# -ge 2 ]] || fail '--ssh-alias requires a value'
      SSH_ALIAS="$2"; shift 2 ;;
    --admin-password)
      [[ $# -ge 2 ]] || fail '--admin-password requires a value'
      ADMIN_PASSWORD="$2"; shift 2 ;;
    --overlay)
      [[ $# -ge 2 ]] || fail '--overlay requires a value'
      OVERLAY="$2"; shift 2 ;;
    --confirm-destroy)
      [[ $# -ge 2 ]] || fail '--confirm-destroy requires a value'
      CONFIRM_DESTROY="$2"; shift 2 ;;
    --help|-h) usage; exit 0 ;;
    *) usage >&2; exit 64 ;;
  esac
done

[[ "$TAG" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || fail 'tag must be an immutable vX.Y.Z release tag'
[[ "$TARGET" == production || "$TARGET" == production-candidate ]] || fail 'target must be production or production-candidate'
[[ "$MODE" == fresh || "$MODE" == upgrade ]] || fail 'choose exactly one of --fresh or --upgrade'
[[ $((APPLY + DRY_RUN)) -eq 1 ]] || fail 'choose exactly one of --apply or --dry-run'
if [[ "$MODE" == fresh && "$CONFIRM_DESTROY" != "$TARGET" ]]; then
  fail "--fresh requires --confirm-destroy $TARGET"
fi
if [[ -n "$OVERLAY" ]]; then
  [[ "$TARGET" == production-candidate ]] || fail '--overlay is allowed only for production-candidate'
  [[ -f "$OVERLAY" ]] || fail "overlay file is unavailable: $OVERLAY"
  [[ "$DEMO_MODE" == enabled ]] || fail 'overlay deployment requires PEANUT_DEMO_MODE=enabled'
  for value in "$DEMO_TENANT_A_EMAIL" "$DEMO_TENANT_B_EMAIL" "$DEMO_SHARED_PASSWORD" \
    "$DEMO_TENANT_A_HOST" "$DEMO_TENANT_B_HOST" "$DEMO_DOCS_URL"; do
    [[ -n "$value" ]] || fail 'overlay deployment is missing a required PEANUT_DEMO_* value'
  done
fi
[[ -f "$REGISTRY" ]] || fail "missing resource registry: $REGISTRY"
command -v git >/dev/null || fail 'git is required'
command -v jq >/dev/null || fail 'jq is required'

cd "$ROOT_DIR"
git diff --quiet || fail 'source checkout has unstaged changes'
git diff --cached --quiet || fail 'source checkout has staged changes'

target_json() {
  jq -e --arg id "$1" '.. | objects | select(.stable_resource_id == $id)' "$REGISTRY"
}

deployment_id="peanut-admin-${TARGET}-deployment"
database_id="$(target_json "$deployment_id" | jq -r '.database_resource_id')"
compose_project="$(target_json "$deployment_id" | jq -r '.compose_project')"
remote_root="$(target_json "$deployment_id" | jq -r '.deployment_root')"
origin_port="$(target_json "$deployment_id" | jq -r '.runtime_resource_ids[0] as $x | .. | objects | select(.stable_resource_id == $x) | .published_endpoint.port')"
deployment_mode="$(target_json "$deployment_id" | jq -r '.required_non_secret_environment.DEPLOYMENT_MODE // "multi-tenant"')"
if [[ "$TARGET" == production ]]; then
  deployment_mode="standalone"
  origin_port="$(target_json peanut-admin-production-application-containers | jq -r '.published_endpoint.port')"
else
  deployment_mode="multi-tenant"
  origin_port="$(target_json peanut-admin-production-candidate-application-containers | jq -r '.published_endpoint.port')"
fi
[[ "$database_id" != null && "$compose_project" != null && "$remote_root" != null && "$origin_port" != null ]] || fail "incomplete registry entry for $deployment_id"
if [[ -n "$OVERLAY" ]]; then
  domains_json="$(target_json peanut-admin-production-candidate-domains)"
  jq -e --arg host "$DEMO_TENANT_A_HOST" \
    '.tenant_entry_bindings[$host] == "tenant-a/admin-web"' <<<"$domains_json" >/dev/null \
    || fail 'Tenant A demo Host does not match the registered binding plan'
  jq -e --arg host "$DEMO_TENANT_B_HOST" \
    '.tenant_entry_bindings[$host] == "tenant-b/admin-web"' <<<"$domains_json" >/dev/null \
    || fail 'Tenant B demo Host does not match the registered binding plan'
fi

if ! git rev-parse --verify --quiet "$TAG^{tag}" >/dev/null; then
  git fetch --quiet origin "refs/tags/$TAG:refs/tags/$TAG" || fail "cannot fetch $TAG from origin"
fi
[[ "$(git cat-file -t "$TAG" 2>/dev/null || true)" == tag ]] || fail "$TAG is not an annotated tag"
tag_commit="$(git rev-parse "$TAG^{commit}")"
remote_commit="$(git ls-remote --tags origin "refs/tags/$TAG^{}" | awk 'NR == 1 { print $1 }')"
[[ -n "$remote_commit" && "$remote_commit" == "$tag_commit" ]] || fail "$TAG local and remote commit identities differ"
version="${TAG#v}"
metadata_version="$(git show "$TAG:RELEASE_METADATA.json" | jq -r '.version // empty')"
metadata_tag="$(git show "$TAG:RELEASE_METADATA.json" | jq -r '.expected_tag // empty')"
[[ "$metadata_version" == "$version" && "$metadata_tag" == "$TAG" ]] || fail "RELEASE_METADATA.json does not match $TAG"

if [[ "$MODE" == fresh && ( -z "$ADMIN_EMAIL" || -z "$ADMIN_PASSWORD" ) ]]; then
  fail 'fresh deployment requires PEANUT_GENERATED_ADMIN_EMAIL and PEANUT_GENERATED_ADMIN_PASSWORD'
fi
if [[ "$MODE" == fresh && "$deployment_mode" == multi-tenant ]]; then
  [[ -n "$PLATFORM_EMAIL" && -n "$PLATFORM_PASSWORD" ]] \
    || fail 'fresh multi-tenant deployment requires PEANUT_GENERATED_PLATFORM_EMAIL and PEANUT_GENERATED_PLATFORM_PASSWORD'
fi
if [[ "$MODE" == fresh && -n "$OVERLAY" ]]; then
  demo_emails=(
    "${ADMIN_EMAIL,,}"
    "${PLATFORM_EMAIL,,}"
    "${DEMO_TENANT_A_EMAIL,,}"
    "${DEMO_TENANT_B_EMAIL,,}"
  )
  [[ "$(printf '%s\n' "${demo_emails[@]}" | sort -u | wc -l | tr -d ' ')" == 4 ]] \
    || fail 'fresh demo deployment requires distinct default Admin, Platform, Tenant A and Tenant B emails'
fi
for pair in \
  "PEANUT_GENERATED_ADMIN_EMAIL=$ADMIN_EMAIL" \
  "PEANUT_GENERATED_ADMIN_PASSWORD=$ADMIN_PASSWORD" \
  "PEANUT_GENERATED_PLATFORM_EMAIL=$PLATFORM_EMAIL" \
  "PEANUT_GENERATED_PLATFORM_PASSWORD=$PLATFORM_PASSWORD" \
  "PEANUT_DEMO_TENANT_A_EMAIL=$DEMO_TENANT_A_EMAIL" \
  "PEANUT_DEMO_TENANT_B_EMAIL=$DEMO_TENANT_B_EMAIL" \
  "PEANUT_DEMO_SHARED_PASSWORD=$DEMO_SHARED_PASSWORD" \
  "PEANUT_DEMO_TENANT_A_HOST=$DEMO_TENANT_A_HOST" \
  "PEANUT_DEMO_TENANT_B_HOST=$DEMO_TENANT_B_HOST" \
  "PEANUT_DEMO_DOCS_URL=$DEMO_DOCS_URL"; do
  validate_env_value "${pair%%=*}" "${pair#*=}"
done

overlay_sha256=""
if [[ -n "$OVERLAY" ]]; then
  command -v shasum >/dev/null || fail 'shasum is required for an overlay deployment'
  overlay_sha256="$(shasum -a 256 "$OVERLAY" | awk '{print $1}')"
  [[ "$overlay_sha256" =~ ^[0-9a-f]{64}$ ]] || fail 'cannot calculate overlay SHA-256'
fi

printf 'release=%s\ncommit=%s\ntarget=%s\nmode=%s\nssh=%s\nremote_root=%s\ncompose_project=%s\norigin_port=%s\ndatabase_resource=%s\ndeployment_mode=%s\n' \
  "$TAG" "$tag_commit" "$TARGET" "$MODE" "$SSH_ALIAS" "$remote_root" "$compose_project" "$origin_port" "$database_id" "$deployment_mode"
[[ -z "$overlay_sha256" ]] || printf 'overlay_sha256=%s\n' "$overlay_sha256"

if [[ "$DRY_RUN" == 1 ]]; then
  printf 'plan=validate remote path, fetch tag, apply checked overlay when present, build images, %s database, restart Compose, health smoke\n' "$MODE"
  [[ "$MODE" != fresh ]] || printf 'warning=--fresh will stop the target and remove its Compose volumes before installing\n'
  exit 0
fi

[[ "$APPLY" == 1 ]] || fail 'pass --apply to execute the deployment'
command -v ssh >/dev/null || fail 'ssh is required for --apply'
command -v scp >/dev/null || fail 'scp is required for --apply'

archive_file="$(mktemp -t peanut-admin-release.XXXXXX.tar)"
remote_archive="/tmp/peanut-admin-${version}-$$.tar"
secrets_file="$(mktemp -t peanut-admin-deploy-secrets.XXXXXX.env)"
remote_secrets="/tmp/peanut-admin-deploy-secrets-$$.env"
remote_overlay=""
trap 'rm -f "$archive_file" "$secrets_file"' EXIT
git archive --format=tar "$TAG" -o "$archive_file"
umask 077
{
  printf 'ADMIN_INITIAL_EMAIL=%q\n' "$ADMIN_EMAIL"
  printf 'ADMIN_INITIAL_PASSWORD=%q\n' "$ADMIN_PASSWORD"
  printf 'PLATFORM_INITIAL_EMAIL=%q\n' "$PLATFORM_EMAIL"
  printf 'PLATFORM_INITIAL_PASSWORD=%q\n' "$PLATFORM_PASSWORD"
  printf 'PEANUT_DEMO_MODE=%q\n' "$DEMO_MODE"
  printf 'PEANUT_DEMO_TENANT_A_EMAIL=%q\n' "$DEMO_TENANT_A_EMAIL"
  printf 'PEANUT_DEMO_TENANT_B_EMAIL=%q\n' "$DEMO_TENANT_B_EMAIL"
  printf 'PEANUT_DEMO_SHARED_PASSWORD=%q\n' "$DEMO_SHARED_PASSWORD"
  printf 'PEANUT_DEMO_TENANT_A_HOST=%q\n' "$DEMO_TENANT_A_HOST"
  printf 'PEANUT_DEMO_TENANT_B_HOST=%q\n' "$DEMO_TENANT_B_HOST"
  printf 'PEANUT_DEMO_DOCS_URL=%q\n' "$DEMO_DOCS_URL"
} >"$secrets_file"
scp -q "$archive_file" "$SSH_ALIAS:$remote_archive" || fail 'cannot transfer immutable release archive'
scp -q "$secrets_file" "$SSH_ALIAS:$remote_secrets" || fail 'cannot transfer deployment credential payload'
if [[ -n "$OVERLAY" ]]; then
  remote_overlay="/tmp/peanut-admin-demo-overlay-$$.tar"
  scp -q "$OVERLAY" "$SSH_ALIAS:$remote_overlay" || fail 'cannot transfer demo overlay'
fi

ssh -o BatchMode=yes "$SSH_ALIAS" bash -s -- \
  "$TAG" "$tag_commit" "$MODE" "$TARGET" "$remote_root" "$compose_project" "$origin_port" "$database_id" "$deployment_mode" "$remote_archive" "$remote_secrets" "$remote_overlay" "$overlay_sha256" <<'REMOTE_SCRIPT'
set -Eeuo pipefail

tag="$1"
expected_commit="$2"
mode="$3"
target="$4"
root="$5"
project="$6"
port="$7"
database_resource="$8"
deployment_mode="$9"
archive="${10}"
secrets="${11}"
overlay="${12:-}"
expected_overlay_sha="${13:-}"

fail() { printf 'remote deploy: %s\n' "$1" >&2; exit 1; }
[[ "$root" == /www/docker/peanut-admin || "$root" == /www/docker/peanut-admin-candidate ]] || fail 'unregistered deployment root'
[[ "$project" == peanut-admin || "$project" == peanut-admin-candidate ]] || fail 'unregistered compose project'
[[ "$port" == 18092 || "$port" == 18093 ]] || fail 'unregistered origin port'
[[ "$target" == production || "$target" == production-candidate ]] || fail 'unregistered deployment target'
[[ -d "$root" && -f "$root/compose.yaml" && -f "$root/.env" ]] || fail "deployment files missing under $root"
[[ -f "$secrets" ]] || fail 'deployment credential payload is missing'
chmod 600 "$secrets"
set -a
# shellcheck disable=SC1090
source "$secrets"
set +a
rm -f "$secrets"

cd "$root"
sudo -n grep -Fqx "PEANUT_DEPLOYMENT_TARGET=$target" .env || fail '.env deployment target mismatch'
sudo -n grep -Fqx "PEANUT_DATABASE_RESOURCE_ID=$database_resource" .env || fail '.env database resource mismatch'
sudo -n grep -Fqx "HTTP_PORT=$port" .env || fail '.env origin port mismatch'
sudo -n grep -Fqx "DEPLOYMENT_MODE=$deployment_mode" .env || fail '.env deployment mode mismatch'

compose=(sudo -n docker compose --env-file .env -p "$project" -f compose.yaml --profile bundled-db)
"${compose[@]}" config >/dev/null || fail 'Compose configuration is invalid'

if [[ "$mode" == fresh ]]; then
  printf 'fresh target: stopping stack and removing only registered Compose volumes\n'
  "${compose[@]}" down --volumes --remove-orphans
else
  printf 'upgrade target: preserving database and persistent storage\n'
  "${compose[@]}" stop --timeout 60 nginx cron php || true
fi

[[ -f "$archive" ]] || fail 'immutable release archive missing on remote'
staging="$(mktemp -d /tmp/peanut-admin-release.XXXXXX)"
sudo -n tar --no-same-owner -xf "$archive" -C "$staging" || fail 'cannot unpack immutable release archive'
if [[ -n "$overlay" ]]; then
  [[ -f "$overlay" && "$expected_overlay_sha" =~ ^[0-9a-f]{64}$ ]] || fail 'demo overlay identity is incomplete'
  actual_overlay_sha="$(sha256sum "$overlay" | awk '{print $1}')"
  [[ "$actual_overlay_sha" == "$expected_overlay_sha" ]] || fail 'demo overlay SHA-256 mismatch'
  sudo -n tar --no-same-owner -xf "$overlay" -C "$staging" || fail 'cannot unpack demo overlay'
  overlay_base_tag="$(jq -r '.base_tag // empty' "$staging/DEMO_PATCH_METADATA.json")"
  [[ "$overlay_base_tag" == "$tag" ]] || fail 'demo overlay targets another base release'
fi
sudo -n find "$root" -mindepth 1 -maxdepth 1 \
  ! -name .env ! -name backups -exec rm -rf -- {} +
sudo -n cp -a "$staging"/. "$root"/
sudo -n rm -rf "$staging"
sudo -n rm -f "$archive"
[[ -z "$overlay" ]] || sudo -n rm -f "$overlay"
set_env_key() {
  local key="$1" value="$2"
  local temporary
  temporary="$(mktemp)"
  sudo -n awk -v key="$key" -v value="$value" '
    BEGIN { replaced = 0 }
    $0 ~ "^" key "=" { if (!replaced) print key "=" value; replaced = 1; next }
    { print }
    END { if (!replaced) print key "=" value }
  ' .env >"$temporary"
  sudo -n install -m 600 "$temporary" .env
  rm -f "$temporary"
}
image_suffix="${tag#v}"
if [[ -n "$expected_overlay_sha" ]]; then
  image_suffix="${image_suffix}-demo-${expected_overlay_sha:0:12}"
fi
set_env_key PHP_IMAGE "peanut-admin-php:${image_suffix}"
set_env_key NGINX_IMAGE "peanut-admin-nginx:${image_suffix}"
if [[ "$mode" == fresh ]]; then
  [[ -n "$ADMIN_INITIAL_EMAIL" && -n "$ADMIN_INITIAL_PASSWORD" ]] || fail 'fresh admin credentials are incomplete'
  set_env_key ADMIN_INITIAL_EMAIL "$ADMIN_INITIAL_EMAIL"
  set_env_key ADMIN_INITIAL_PASSWORD "$ADMIN_INITIAL_PASSWORD"
  if [[ "$deployment_mode" == multi-tenant ]]; then
    [[ -n "$PLATFORM_INITIAL_EMAIL" && -n "$PLATFORM_INITIAL_PASSWORD" ]] || fail 'fresh Platform credentials are incomplete'
    set_env_key PLATFORM_INITIAL_EMAIL "$PLATFORM_INITIAL_EMAIL"
    set_env_key PLATFORM_INITIAL_PASSWORD "$PLATFORM_INITIAL_PASSWORD"
  fi
fi
if [[ -n "$expected_overlay_sha" ]]; then
  for key in PEANUT_DEMO_MODE PEANUT_DEMO_TENANT_A_EMAIL PEANUT_DEMO_TENANT_B_EMAIL \
    PEANUT_DEMO_SHARED_PASSWORD PEANUT_DEMO_TENANT_A_HOST PEANUT_DEMO_TENANT_B_HOST PEANUT_DEMO_DOCS_URL; do
    set_env_key "$key" "${!key:-}"
  done
fi
printf '%s\n' "$tag" | sudo -n tee .release-tag >/dev/null
printf '%s\n' "$expected_commit" | sudo -n tee .release-commit >/dev/null
if [[ -n "$expected_overlay_sha" ]]; then
  printf '%s\n' "$expected_overlay_sha" | sudo -n tee .demo-overlay-sha256 >/dev/null
fi
actual_commit="$expected_commit"

compose=(sudo -n docker compose --env-file .env -p "$project" -f compose.yaml --profile bundled-db)
"${compose[@]}" config >/dev/null || fail 'updated Compose configuration is invalid'
"${compose[@]}" build
# Run database work with the PHP entrypoint bypassed. The normal entrypoint
# intentionally refuses an incomplete schema; an upgrade must apply the
# additive migrations before the application process is allowed to start.
"${compose[@]}" up -d --wait mysql
if [[ "$mode" == fresh ]]; then
  "${compose[@]}" run -T --rm --no-deps --entrypoint php php server/database/install.php </dev/null
fi
"${compose[@]}" run -T --rm --no-deps --entrypoint php php server/database/migrate.php </dev/null
"${compose[@]}" run -T --rm --no-deps --entrypoint php php server/database/migrate.php --current </dev/null
if [[ "$mode" == fresh && "$PEANUT_DEMO_MODE" == enabled ]]; then
  demo_result="$("${compose[@]}" run -T --rm --no-deps --entrypoint php php server/database/seed-multi-tenant-demo.php --apply </dev/null)"
  printf '%s\n' "$demo_result"
  tenant_a_id="$(printf '%s' "$demo_result" | jq -r '.tenant_a_id // empty')"
  tenant_b_id="$(printf '%s' "$demo_result" | jq -r '.tenant_b_id // empty')"
  [[ "$tenant_a_id" =~ ^[1-9][0-9]*$ && "$tenant_b_id" =~ ^[1-9][0-9]*$ ]] || fail 'demo Tenant seed returned invalid identifiers'
  for tenant_id in "$tenant_a_id" "$tenant_b_id"; do
    "${compose[@]}" run -T --rm --no-deps --entrypoint php \
      -e PEANUT_DEMO_TENANT_ID="$tenant_id" php server/database/seed-demo-data.php --apply </dev/null
  done
fi
"${compose[@]}" up -d --wait
"${compose[@]}" ps

curl --fail --silent --show-error --retry 12 --retry-delay 2 "http://127.0.0.1:${port}/healthz" >/dev/null
runtime_version="$(curl --fail --silent --show-error "http://127.0.0.1:${port}/legal/RELEASE_METADATA.json" | jq -r '.version // empty')"
[[ "$runtime_version" == "${tag#v}" ]] || fail "runtime metadata is $runtime_version, expected ${tag#v}"
printf 'deployed_tag=%s\ncommit=%s\nruntime_version=%s\ntarget=%s\n' "$tag" "$actual_commit" "$runtime_version" "$target"
[[ -z "$expected_overlay_sha" ]] || printf 'demo_overlay_sha256=%s\n' "$expected_overlay_sha"
REMOTE_SCRIPT
