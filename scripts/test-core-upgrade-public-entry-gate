#!/usr/bin/env bash

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
FIXTURE="$ROOT/server/tests/fixtures/core-upgrade-compatibility"
CASES="$FIXTURE/web-public-entry-gate-cases.json"
SCANNER="$FIXTURE/web-public-entry-gate.mjs"
WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT INT TERM

jq '{name:"@peanut-admin/admin", exports:.exports}' "$CASES" >"$WORK/package.json"
mkdir -p "$WORK/application/web/src"

count="$(jq '.cases | length' "$CASES")"
for ((index = 0; index < count; index += 1)); do
  name="$(jq -r ".cases[$index].name" "$CASES")"
  expected="$(jq -r ".cases[$index].expected" "$CASES")"
  jq -r ".cases[$index].source" "$CASES" >"$WORK/application/web/src/case.ts"
  if node "$SCANNER" "$WORK/application" "$WORK/package.json" >"$WORK/stdout" 2>"$WORK/stderr"; then
    actual=pass
  else
    actual=fail
  fi
  [[ "$actual" == "$expected" ]] || {
    printf 'public-entry fixture failed: %s expected=%s actual=%s\n' "$name" "$expected" "$actual" >&2
    cat "$WORK/stderr" >&2
    exit 1
  }
done

printf 'CORE-UPGRADE-PUBLIC-ENTRY-FIXTURES passed; cases=%s\n' "$count"
