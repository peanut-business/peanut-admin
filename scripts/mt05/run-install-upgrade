#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  scripts/mt05/run-install-upgrade --candidate <40-hex-commit> --run-id <run-id> [options]

Options:
  --candidate <commit>     Exact 40-character candidate commit (required).
  --run-id <id>            Unique run id: letters, digits, dot, underscore, hyphen (required).
  --output-dir <path>      Evidence directory (default: output/mt05/<run-id>).
  --dry-run                Validate inputs and print the isolated three-mode plan; no DB access.
  --keep-failed-resources  Keep this run's database and temporary directory after a failure.
  -h, --help               Show this help.

Database environment (required unless --dry-run):
  MT05_DB_HOST, MT05_DB_PORT, MT05_DB_USER, MT05_DB_PASSWORD

Installer environment (required unless --dry-run):
  MT05_ADMIN_INITIAL_PASSWORD, MT05_ADMIN_INITIAL_EMAIL

Optional environment:
  MT05_OUTPUT_ROOT          Replaces the default output/mt05 root.
EOF
}

die() {
  printf 'MT05 harness error: %s\n' "$*" >&2
  exit 1
}

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
FIXTURE_DIR="$REPO_ROOT/server/tests/fixtures/mt05"
MATRIX_FILE="$FIXTURE_DIR/matrix.tsv"
INSPECTOR="$FIXTURE_DIR/inspect.php"

CANDIDATE=""
RUN_ID=""
OUTPUT_DIR=""
DRY_RUN=0
KEEP_FAILED=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --candidate)
      [[ $# -ge 2 ]] || die '--candidate requires a value'
      CANDIDATE="$2"
      shift 2
      ;;
    --run-id)
      [[ $# -ge 2 ]] || die '--run-id requires a value'
      RUN_ID="$2"
      shift 2
      ;;
    --output-dir)
      [[ $# -ge 2 ]] || die '--output-dir requires a value'
      OUTPUT_DIR="$2"
      shift 2
      ;;
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    --keep-failed-resources)
      KEEP_FAILED=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown argument: $1"
      ;;
  esac
done

[[ "$CANDIDATE" =~ ^[0-9a-f]{40}$ ]] || die '--candidate must be an exact lowercase 40-hex commit'
[[ "$RUN_ID" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$ ]] || die '--run-id has an invalid format or exceeds 32 characters'
[[ -f "$MATRIX_FILE" ]] || die "missing fixture: $MATRIX_FILE"
[[ -f "$INSPECTOR" ]] || die "missing fixture: $INSPECTOR"

RESOLVED_CANDIDATE="$(git -C "$REPO_ROOT" rev-parse --verify "${CANDIDATE}^{commit}" 2>/dev/null || true)"
[[ "$RESOLVED_CANDIDATE" == "$CANDIDATE" ]] || die 'candidate commit is unavailable in this repository'
HEAD_COMMIT="$(git -C "$REPO_ROOT" rev-parse HEAD)"
[[ "$HEAD_COMMIT" == "$CANDIDATE" ]] || die "checked-out HEAD $HEAD_COMMIT does not equal candidate $CANDIDATE"
git -C "$REPO_ROOT" diff --quiet -- || die 'candidate worktree has unstaged tracked changes'
git -C "$REPO_ROOT" diff --cached --quiet -- || die 'candidate worktree has staged tracked changes'
[[ -z "$(git -C "$REPO_ROOT" status --porcelain)" ]] || die 'candidate worktree has untracked or modified files'
git -C "$REPO_ROOT" rev-parse --verify 'v1.0.0^{commit}' >/dev/null 2>&1 || die 'required baseline tag v1.0.0 is unavailable'

MATRIX_ROWS="$(awk -F '\t' 'NR > 1 && NF { count++ } END { print count + 0 }' "$MATRIX_FILE")"
[[ "$MATRIX_ROWS" == '3' ]] || die 'matrix fixture must define exactly three modes'

if [[ -z "$OUTPUT_DIR" ]]; then
  OUTPUT_ROOT="${MT05_OUTPUT_ROOT:-$REPO_ROOT/output/mt05}"
  OUTPUT_DIR="$OUTPUT_ROOT/$RUN_ID"
fi

if [[ "$DRY_RUN" == '1' ]]; then
  printf 'candidate=%s\n' "$CANDIDATE"
  printf 'candidate_tree=%s\n' "$(git -C "$REPO_ROOT" rev-parse "${CANDIDATE}^{tree}")"
  printf 'run_id=%s\n' "$RUN_ID"
  printf 'output_dir=%s\n' "$OUTPUT_DIR"
  printf 'baseline_v1_commit=%s\n' "$(git -C "$REPO_ROOT" rev-parse 'v1.0.0^{commit}')"
  printf 'matrix:\n'
  awk -F '\t' 'NR > 1 && NF { printf "  mode=%s action=%s deployment_mode=%s baseline=%s\n", $1, $2, $3, $4 }' "$MATRIX_FILE"
  printf 'dry_run=ok (no database or temporary resource was created)\n'
  exit 0
fi

for required in MT05_DB_HOST MT05_DB_PORT MT05_DB_USER MT05_DB_PASSWORD MT05_ADMIN_INITIAL_PASSWORD MT05_ADMIN_INITIAL_EMAIL; do
  [[ -n "${!required:-}" ]] || die "missing required environment: $required"
done
[[ "$MT05_DB_PORT" =~ ^[0-9]{1,5}$ ]] || die 'MT05_DB_PORT must be numeric'
command -v php >/dev/null 2>&1 || die 'php is required'
command -v mysql >/dev/null 2>&1 || die 'mysql client is required'
command -v tar >/dev/null 2>&1 || die 'tar is required'
[[ -f "$REPO_ROOT/server/vendor/autoload.php" ]] || die 'candidate server/vendor/autoload.php is required'
[[ ! -e "$OUTPUT_DIR" ]] || die "output directory already exists: $OUTPUT_DIR"

mkdir -p "$OUTPUT_DIR"
TMP_PARENT="${TMPDIR:-/tmp}"
TMP_PARENT="${TMP_PARENT%/}"
TMP_ROOT="$(mktemp -d "$TMP_PARENT/peanut-mt05.${RUN_ID}.XXXXXX")"
RUN_SLUG="$(printf '%s' "$RUN_ID" | tr '[:upper:].-' '[:lower:]__' | tr -cd 'a-z0-9_')"
SHORT_CANDIDATE="${CANDIDATE:0:10}"
DB_PREFIX="pa_mt05_${RUN_SLUG}_${SHORT_CANDIDATE}_"
CURRENT_DB=""
DB_CREATED=0
COMPLETED=0

export MYSQL_PWD="$MT05_DB_PASSWORD"

mysql_base() {
  mysql --protocol=TCP \
    --host="$MT05_DB_HOST" \
    --port="$MT05_DB_PORT" \
    --user="$MT05_DB_USER" \
    --batch --raw --skip-column-names "$@"
}

drop_owned_database() {
  [[ "$DB_CREATED" == '1' ]] || return 0
  [[ -n "$CURRENT_DB" && "$CURRENT_DB" == "$DB_PREFIX"* ]] || die 'refusing to clean a database outside this run namespace'
  mysql_base --execute="DROP DATABASE IF EXISTS \`$CURRENT_DB\`;"
  DB_CREATED=0
  CURRENT_DB=""
}

on_exit() {
  status=$?
  if [[ "$status" -ne 0 ]]; then
    printf 'status=failed\nexit_code=%s\ncandidate=%s\nrun_id=%s\ndatabase=%s\ntemporary_dir=%s\n' \
      "$status" "$CANDIDATE" "$RUN_ID" "$CURRENT_DB" "$TMP_ROOT" >"$OUTPUT_DIR/failure.txt"
    if [[ "$KEEP_FAILED" == '1' ]]; then
      printf 'MT05 failed; run-owned resources retained. Evidence: %s\n' "$OUTPUT_DIR" >&2
      return
    fi
  fi
  drop_owned_database || true
  rm -rf -- "$TMP_ROOT"
  if [[ "$status" -ne 0 ]]; then
    printf 'MT05 failed; exact command logs retained in %s\n' "$OUTPUT_DIR" >&2
  fi
}
trap on_exit EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

CANDIDATE_TREE="$(git -C "$REPO_ROOT" rev-parse "${CANDIDATE}^{tree}")"
BASELINE_COMMIT="$(git -C "$REPO_ROOT" rev-parse 'v1.0.0^{commit}')"
BASELINE_TREE="$(git -C "$REPO_ROOT" rev-parse 'v1.0.0^{tree}')"
{
  printf 'candidate=%s\n' "$CANDIDATE"
  printf 'candidate_tree=%s\n' "$CANDIDATE_TREE"
  printf 'run_id=%s\n' "$RUN_ID"
  printf 'baseline_ref=v1.0.0\n'
  printf 'baseline_commit=%s\n' "$BASELINE_COMMIT"
  printf 'baseline_tree=%s\n' "$BASELINE_TREE"
  printf 'matrix_fixture_sha256=%s\n' "$(shasum -a 256 "$MATRIX_FILE" | awk '{print $1}')"
  printf 'inspector_fixture_sha256=%s\n' "$(shasum -a 256 "$INSPECTOR" | awk '{print $1}')"
} >"$OUTPUT_DIR/run.env"

LEGACY_ROOT="$TMP_ROOT/v1.0.0"
mkdir -p "$LEGACY_ROOT"
git -C "$REPO_ROOT" archive --format=tar v1.0.0 server/database server/config/brand.json | tar -xf - -C "$LEGACY_ROOT"

run_php_step() {
  label="$1"
  script="$2"
  shift 2
  log_file="$MODE_DIR/${label}.log"
  printf 'step=%s\ncommand=php %s\n' "$label" "${script#$REPO_ROOT/}" >"$log_file"
  if ! php "$script" "$@" >>"$log_file" 2>&1; then
    printf 'exit=failed\n' >>"$log_file"
    return 1
  fi
  printf 'exit=0\n' >>"$log_file"
}

while IFS=$'\t' read -r MODE ACTION DEPLOYMENT_MODE BASELINE_REF; do
  [[ "$MODE" != 'mode' ]] || continue
  [[ -n "$MODE" ]] || continue
  case "$MODE:$ACTION:$DEPLOYMENT_MODE:$BASELINE_REF" in
    standalone-empty:candidate-install:standalone:-|v1-forward:v1-forward:standalone:v1.0.0|multitenant-empty:candidate-install:multitenant:-) ;;
    *) die "unsupported matrix row: $MODE/$ACTION/$DEPLOYMENT_MODE/$BASELINE_REF" ;;
  esac

  CURRENT_DB="${DB_PREFIX}${MODE//-/_}"
  [[ "$CURRENT_DB" =~ ^[a-z0-9_]{1,64}$ ]] || die "generated database name is invalid: $CURRENT_DB"
  MODE_DIR="$OUTPUT_DIR/$MODE"
  mkdir -p "$MODE_DIR"

  exists="$(mysql_base --execute="SELECT COUNT(*) FROM information_schema.SCHEMATA WHERE SCHEMA_NAME='$CURRENT_DB';")"
  [[ "$exists" == '0' ]] || die "isolated database already exists: $CURRENT_DB"
  mysql_base --execute="CREATE DATABASE \`$CURRENT_DB\` CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci;"
  DB_CREATED=1

  export DB_HOST="$MT05_DB_HOST"
  export DB_PORT="$MT05_DB_PORT"
  export DB_NAME="$CURRENT_DB"
  export DB_USER="$MT05_DB_USER"
  export DB_PASS="$MT05_DB_PASSWORD"
  export ADMIN_INITIAL_PASSWORD="$MT05_ADMIN_INITIAL_PASSWORD"
  export ADMIN_INITIAL_EMAIL="$MT05_ADMIN_INITIAL_EMAIL"
  export DEPLOYMENT_MODE="$DEPLOYMENT_MODE"

  if [[ "$ACTION" == 'v1-forward' ]]; then
    run_php_step baseline-install "$LEGACY_ROOT/server/database/install.php"
    run_php_step candidate-migrate "$REPO_ROOT/server/database/migrate.php" --adopt-existing
  else
    run_php_step candidate-install "$REPO_ROOT/server/database/install.php"
  fi

  if ! MT05_MODE="$MODE" MT05_DEPLOYMENT_MODE="$DEPLOYMENT_MODE" MT05_CANDIDATE="$CANDIDATE" MT05_RUN_ID="$RUN_ID" \
    php "$INSPECTOR" >"$MODE_DIR/result.json" 2>"$MODE_DIR/inspect.log"; then
    printf 'exit=failed\n' >>"$MODE_DIR/inspect.log"
    exit 1
  fi
  printf 'exit=0\n' >>"$MODE_DIR/inspect.log"
  drop_owned_database
done <"$MATRIX_FILE"

COMPLETED=1
printf 'status=passed\ncandidate=%s\nrun_id=%s\nmodes=3\n' "$CANDIDATE" "$RUN_ID" >"$OUTPUT_DIR/summary.txt"
printf 'MT05 install/upgrade matrix passed; evidence: %s\n' "$OUTPUT_DIR"
