#!/usr/bin/env bash

set -Eeuo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
ROOT_DIR="$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)"
BASE_TAG="${1:-}"
OUTPUT="${2:-}"

fail() {
  printf 'build-demo-site-patch: %s\n' "$1" >&2
  exit 1
}

version_greater_than() {
  local left="$1" right="$2"
  local left_major left_minor left_patch right_major right_minor right_patch
  IFS=. read -r left_major left_minor left_patch <<<"$left"
  IFS=. read -r right_major right_minor right_patch <<<"$right"
  (( 10#$left_major > 10#$right_major )) && return 0
  (( 10#$left_major < 10#$right_major )) && return 1
  (( 10#$left_minor > 10#$right_minor )) && return 0
  (( 10#$left_minor < 10#$right_minor )) && return 1
  (( 10#$left_patch > 10#$right_patch ))
}

[[ "$BASE_TAG" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] \
  || fail 'usage: scripts/build-demo-site-patch <vX.Y.Z> <output.tar>'
[[ -n "$OUTPUT" ]] || fail 'output path is required'
command -v git >/dev/null || fail 'git is required'
command -v jq >/dev/null || fail 'jq is required'
command -v shasum >/dev/null || fail 'shasum is required'

cd "$ROOT_DIR"
[[ -z "$(git status --porcelain --untracked-files=all)" ]] \
  || fail 'source checkout has tracked or untracked changes'
[[ "$(git cat-file -t "$BASE_TAG" 2>/dev/null || true)" == tag ]] \
  || fail "$BASE_TAG must be an annotated local tag"

files=(
  deploy/docker-compose.prod.yml
  deploy/docker/production.Dockerfile
  plugins.lock
  plugins/official.file/plugin.json
  server/app/adminapi/controller/auth/LoginController.php
  server/app/adminapi/logic/auth/AdminLogic.php
  server/app/adminapi/logic/WorkbenchLogic.php
  server/app/adminapi/logic/article/ArticleLogic.php
  server/app/adminapi/logic/config/ConfigLogic.php
  server/app/adminapi/logic/decoration/DecorationPageLogic.php
  server/app/adminapi/logic/decoration/DecorationTabbarLogic.php
  server/app/Modules/Official/Member/Service/MemberLogic.php
  server/app/adminapi/logic/setting/MiniProgramLogic.php
  server/app/adminapi/logic/setting/OfficialAccountLogic.php
  server/app/adminapi/service/NativeAdminPrincipalRepository.php
  server/app/common/service/DemoAccountPolicy.php
  server/app/api/logic/IndexLogic.php
  server/app/api/logic/OAuthLogic.php
  server/app/api/logic/UserLogic.php
  server/app/common/service/FileService.php
  server/app/common/service/ProductAssetReferenceService.php
  server/app/common/service/RichTextResourceService.php
  server/app/common/service/decoration/DecorationSchemaService.php
  server/app/common/service/file/FileObjectNamespace.php
  server/app/command/TenantModuleProfile.php
  server/app/command/PluginInstall.php
  server/app/command/PluginReconcile.php
  server/app/platform/service/module/ProductTenantModuleProfileService.php
  server/app/platform/invitation/TenantOwnerInvitationPublicService.php
  server/app/platform/service/ApplicationTenantBootstrapService.php
  server/app/platform/service/PdoTenantOwnerAdminProvisioner.php
  server/app/platform/service/plugin/PluginLifecycleService.php
  server/config/console.php
  server/database/migrations/20260822-classify-official-article-permissions.sql
  server/database/seed-multi-tenant-demo.php
  server/route/app.php
  web/src/api/system/config.ts
  web/src/components/menu/index.vue
  web/src/components/navbar/index.vue
  web/src/core/tenant-session.ts
  web/src/layout/default-layout.vue
  web/src/modules/official-file/contribution.ts
  web/src/store/modules/brand/index.ts
  web/src/store/modules/user/index.ts
  web/src/store/modules/user/types.ts
  web/src/views/login/components/login-form.vue
  web/src/views/user/setting/index.vue
  web/src/views/user/setting/locale/en-US.ts
  web/src/views/user/setting/locale/zh-CN.ts
)

migration_target_version="${BASE_TAG#v}"
for file in "${files[@]}"; do
  [[ "$file" == server/database/migrations/*.sql ]] || continue
  [[ -f "$file" ]] || fail "patch source is missing: $file"
  markers="$(sed -nE 's/^[[:space:]]*--[[:space:]]*peanut-release:[[:space:]]*((0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*))[[:space:]]*$/\1/p' "$file")"
  [[ "$(printf '%s\n' "$markers" | sed '/^$/d' | wc -l | tr -d ' ')" == 1 ]] \
    || fail "overlay migration must contain exactly one peanut-release marker: $file"
  marker="$(printf '%s\n' "$markers" | sed '/^$/d')"
  if version_greater_than "$marker" "$migration_target_version"; then
    migration_target_version="$marker"
  fi
done

staging="$(mktemp -d -t peanut-admin-demo-patch.XXXXXX)"
trap 'rm -rf "$staging"' EXIT
for file in "${files[@]}"; do
  [[ -f "$file" ]] || fail "patch source is missing: $file"
  git ls-files --error-unmatch -- "$file" >/dev/null 2>&1 \
    || fail "patch source is not tracked by overlay commit: $file"
  mkdir -p "$staging/$(dirname "$file")"
  cp "$file" "$staging/$file"
done

file_json='[]'
for file in "${files[@]}"; do
  digest="$(shasum -a 256 "$file" | awk '{print $1}')"
  file_json="$(jq -c --arg path "$file" --arg sha "$digest" \
    '. + [{path:$path,sha256:$sha}]' <<<"$file_json")"
done
jq -n \
  --arg schema_version '1' \
  --arg base_tag "$BASE_TAG" \
  --arg base_commit "$(git rev-parse "$BASE_TAG^{commit}")" \
  --arg overlay_commit "$(git rev-parse HEAD)" \
  --arg migration_target_version "$migration_target_version" \
  --argjson files "$file_json" \
  '{schema_version:($schema_version|tonumber),kind:"peanut-admin-demo-site-overlay",base_tag:$base_tag,base_commit:$base_commit,overlay_commit:$overlay_commit,migration_target_version:$migration_target_version,files:$files}' \
  >"$staging/DEMO_PATCH_METADATA.json"

mkdir -p "$(dirname "$OUTPUT")"
tar -cf "$OUTPUT" -C "$staging" .
printf 'patch=%s\nsha256=%s\nbase_tag=%s\noverlay_commit=%s\nmigration_target_version=%s\nfiles=%d\n' \
  "$OUTPUT" "$(shasum -a 256 "$OUTPUT" | awk '{print $1}')" "$BASE_TAG" \
  "$(git rev-parse HEAD)" "$migration_target_version" "${#files[@]}"
