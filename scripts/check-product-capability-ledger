#!/usr/bin/env php
<?php

declare(strict_types=1);

const START_MARKER = '<!-- CAPABILITY_STATUS_GENERATED_START -->';
const END_MARKER = '<!-- CAPABILITY_STATUS_GENERATED_END -->';

$root = dirname(__DIR__);
$ledgerPath = $root . '/docs/product-status/capability-ledger.json';
$schemaPath = $root . '/docs/product-status/schema/capability-ledger.schema.json';
$readmePath = $root . '/docs/product-status/README.md';
$write = in_array('--write', $argv, true);

try {
    $ledger = json_decode(
        (string) file_get_contents($ledgerPath),
        true,
        flags: JSON_THROW_ON_ERROR,
    );
} catch (Throwable $exception) {
    fail('cannot decode capability ledger: ' . $exception->getMessage());
}

if (!is_array($ledger)) {
    fail('capability ledger root must be an object');
}

$statuses = [
    'planned',
    'in_progress',
    'implemented',
    'verified',
    'blocked',
    'deferred',
    'out_of_scope',
    'retired',
];
$evidenceKinds = ['ci', 'document', 'git', 'pull_request', 'release', 'report', 'resource', 'tag'];

try {
    $schema = json_decode(
        (string) file_get_contents($schemaPath),
        true,
        flags: JSON_THROW_ON_ERROR,
    );
} catch (Throwable $exception) {
    fail('cannot decode capability ledger schema: ' . $exception->getMessage());
}
expect(is_array($schema), 'capability ledger schema root must be an object');
$schemaStatuses = $schema['$defs']['status']['enum'] ?? null;
$schemaEvidenceKinds = $schema['$defs']['evidence']['properties']['kind']['enum'] ?? null;
expect($schemaStatuses === $statuses, 'schema status enum differs from the semantic validator');
expect($schemaEvidenceKinds === $evidenceKinds, 'schema evidence kind enum differs from the semantic validator');

exactKeys(
    $ledger,
    ['schema_version', 'title', 'visibility', 'facts_baseline', 'overall', 'capabilities'],
    'ledger',
);
expect($ledger['schema_version'] === 1, 'schema_version must be 1');
expect($ledger['visibility'] === 'internal', 'visibility must remain internal');
nonEmptyString($ledger['title'], 'title');

$baseline = objectValue($ledger['facts_baseline'], 'facts_baseline');
exactKeys($baseline, ['branch', 'commit', 'reviewed_at'], 'facts_baseline');
nonEmptyString($baseline['branch'], 'facts_baseline.branch');
expect(
    is_string($baseline['commit']) && preg_match('/^[0-9a-f]{40}$/', $baseline['commit']) === 1,
    'facts_baseline.commit must be a full lowercase Git SHA',
);
expect(
    is_string($baseline['reviewed_at'])
        && preg_match('/^\d{4}-\d{2}-\d{2}$/', $baseline['reviewed_at']) === 1
        && strtotime($baseline['reviewed_at']) !== false,
    'facts_baseline.reviewed_at must be YYYY-MM-DD',
);

$overall = objectValue($ledger['overall'], 'overall');
exactKeys($overall, ['id', 'status', 'summary'], 'overall');
capabilityId($overall['id'], 'overall.id');
enumValue($overall['status'], $statuses, 'overall.status');
nonEmptyString($overall['summary'], 'overall.summary');

expect(is_array($ledger['capabilities']) && $ledger['capabilities'] !== [], 'capabilities must be a non-empty array');

$ids = [];
$dependencies = [];
$capabilities = [];
$requiredKeys = ['id', 'name', 'area', 'status', 'summary', 'acceptance', 'evidence'];
$optionalKeys = ['dependencies', 'blockers', 'deferral', 'paths'];

foreach ($ledger['capabilities'] as $index => $rawCapability) {
    $context = "capabilities[$index]";
    $capability = objectValue($rawCapability, $context);
    exactKeys($capability, [...$requiredKeys, ...$optionalKeys], $context, $requiredKeys);

    $id = capabilityId($capability['id'], "$context.id");
    expect(!isset($ids[$id]), "duplicate capability id: $id");
    $ids[$id] = true;

    nonEmptyString($capability['name'], "$context.name");
    expect(
        is_string($capability['area']) && preg_match('/^[a-z][a-z0-9_-]*$/', $capability['area']) === 1,
        "$context.area must be a lowercase stable identifier",
    );
    $status = enumValue($capability['status'], $statuses, "$context.status");
    nonEmptyString($capability['summary'], "$context.summary");
    nonEmptyStringList($capability['acceptance'], "$context.acceptance", true);

    expect(is_array($capability['evidence']), "$context.evidence must be an array");
    foreach ($capability['evidence'] as $evidenceIndex => $rawEvidence) {
        $evidenceContext = "$context.evidence[$evidenceIndex]";
        $evidence = objectValue($rawEvidence, $evidenceContext);
        exactKeys($evidence, ['kind', 'ref'], $evidenceContext);
        $evidenceKind = enumValue($evidence['kind'], $evidenceKinds, "$evidenceContext.kind");
        $evidenceRef = nonEmptyString($evidence['ref'], "$evidenceContext.ref");
        if (in_array($evidenceKind, ['document', 'report', 'resource'], true)
            && !str_starts_with($evidenceRef, 'https://')) {
            expect(
                !str_starts_with($evidenceRef, '/') && !str_contains($evidenceRef, '..'),
                "$id has unsafe repository evidence reference: $evidenceRef",
            );
            expect(file_exists($root . '/' . $evidenceRef), "$id references missing evidence: $evidenceRef");
        }
    }

    if ($status === 'verified') {
        expect($capability['evidence'] !== [], "$id is verified but has no evidence");
    }
    if ($status === 'blocked') {
        expect(array_key_exists('blockers', $capability), "$id is blocked but has no blockers");
    }
    if (array_key_exists('blockers', $capability)) {
        nonEmptyStringList($capability['blockers'], "$context.blockers", true);
    }

    $requiresDeferral = in_array($status, ['deferred', 'out_of_scope'], true);
    expect(
        !$requiresDeferral || array_key_exists('deferral', $capability),
        "$id is $status but has no deferral reason and resume condition",
    );
    if (array_key_exists('deferral', $capability)) {
        $deferral = objectValue($capability['deferral'], "$context.deferral");
        exactKeys($deferral, ['reason', 'resume_when'], "$context.deferral");
        nonEmptyString($deferral['reason'], "$context.deferral.reason");
        nonEmptyString($deferral['resume_when'], "$context.deferral.resume_when");
    }

    $dependencies[$id] = [];
    if (array_key_exists('dependencies', $capability)) {
        $dependencies[$id] = nonEmptyStringList($capability['dependencies'], "$context.dependencies", false);
        expect(count($dependencies[$id]) === count(array_unique($dependencies[$id])), "$id has duplicate dependencies");
    }

    if (array_key_exists('paths', $capability)) {
        $paths = nonEmptyStringList($capability['paths'], "$context.paths", false);
        expect(count($paths) === count(array_unique($paths)), "$id has duplicate repository paths");
        foreach ($paths as $path) {
            expect(!str_starts_with($path, '/') && !str_contains($path, '..'), "$id has unsafe repository path: $path");
            expect(file_exists($root . '/' . $path), "$id references a missing repository path: $path");
        }
    }

    $capabilities[] = $capability;
}

foreach ($dependencies as $id => $dependencyIds) {
    foreach ($dependencyIds as $dependencyId) {
        expect($dependencyId !== $id, "$id cannot depend on itself");
        expect(isset($ids[$dependencyId]), "$id depends on unknown capability $dependencyId");
    }
}

$generated = renderStatus($ledger, $capabilities);
$readme = (string) file_get_contents($readmePath);
$start = strpos($readme, START_MARKER);
$end = strpos($readme, END_MARKER);
expect($start !== false && $end !== false && $end > $start, 'README.md is missing generated status markers');

$replacement = START_MARKER . "\n" . $generated . "\n" . END_MARKER;
$current = substr($readme, $start, $end + strlen(END_MARKER) - $start);

if ($write) {
    if ($current !== $replacement) {
        $updated = substr($readme, 0, $start) . $replacement . substr($readme, $end + strlen(END_MARKER));
        file_put_contents($readmePath, $updated);
        fwrite(STDOUT, "Updated docs/product-status/README.md from capability ledger.\n");
    }
} else {
    expect(
        $current === $replacement,
        'README.md status is stale; run php scripts/check-product-capability-ledger --write',
    );
}

fwrite(STDOUT, 'Product capability ledger check passed (' . count($capabilities) . " capabilities).\n");

function renderStatus(array $ledger, array $capabilities): string
{
    $groups = [
        '已验证可用' => ['verified'],
        '已实现或正在验收' => ['implemented', 'in_progress'],
        '计划中或受阻' => ['planned', 'blocked'],
        '暂缓或范围外' => ['deferred', 'out_of_scope', 'retired'],
    ];
    $labels = [
        'planned' => '计划中',
        'in_progress' => '进行中',
        'implemented' => '已实现，待验收',
        'verified' => '已验证',
        'blocked' => '受阻',
        'deferred' => '暂缓',
        'out_of_scope' => '范围外',
        'retired' => '已退出',
    ];

    $lines = [
        '> 总体状态：**' . $labels[$ledger['overall']['status']] . '**。' . $ledger['overall']['summary'],
        '>',
        '> 事实基线：`' . $ledger['facts_baseline']['branch'] . '@' . $ledger['facts_baseline']['commit'] .
            '`，复核日期：`' . $ledger['facts_baseline']['reviewed_at'] . '`。',
    ];

    foreach ($groups as $heading => $statuses) {
        $items = array_values(array_filter(
            $capabilities,
            static fn (array $capability): bool => in_array($capability['status'], $statuses, true),
        ));
        if ($items === []) {
            continue;
        }

        $lines[] = '';
        $lines[] = '### ' . $heading;
        $lines[] = '';
        $lines[] = '| ID | 能力 | 状态 | 当前事实 |';
        $lines[] = '|---|---|---|---|';
        foreach ($items as $capability) {
            $lines[] = sprintf(
                '| `%s` | %s | %s | %s |',
                escapeCell($capability['id']),
                escapeCell($capability['name']),
                escapeCell($labels[$capability['status']]),
                escapeCell($capability['summary']),
            );
        }
    }

    return implode("\n", $lines);
}

function escapeCell(string $value): string
{
    return str_replace(["\r", "\n", '|'], [' ', ' ', '\\|'], trim($value));
}

function exactKeys(array $value, array $allowed, string $context, ?array $required = null): void
{
    $required ??= $allowed;
    foreach ($required as $key) {
        expect(array_key_exists($key, $value), "$context is missing required key $key");
    }
    $unknown = array_diff(array_keys($value), $allowed);
    expect($unknown === [], "$context has unknown key(s): " . implode(', ', $unknown));
}

function objectValue(mixed $value, string $context): array
{
    expect(is_array($value) && !array_is_list($value), "$context must be an object");
    return $value;
}

function nonEmptyString(mixed $value, string $context): string
{
    expect(is_string($value) && trim($value) !== '', "$context must be a non-empty string");
    return $value;
}

function nonEmptyStringList(mixed $value, string $context, bool $requireItem): array
{
    expect(is_array($value) && array_is_list($value), "$context must be an array");
    expect(!$requireItem || $value !== [], "$context must not be empty");
    foreach ($value as $index => $item) {
        nonEmptyString($item, "{$context}[$index]");
    }
    return $value;
}

function capabilityId(mixed $value, string $context): string
{
    expect(is_string($value) && preg_match('/^PA-[A-Z0-9]+-[0-9]{3}$/', $value) === 1, "$context is invalid");
    return $value;
}

function enumValue(mixed $value, array $allowed, string $context): string
{
    expect(is_string($value) && in_array($value, $allowed, true), "$context has unsupported value");
    return $value;
}

function expect(bool $condition, string $message): void
{
    if (!$condition) {
        fail($message);
    }
}

function fail(string $message): never
{
    fwrite(STDERR, "ERROR: $message\n");
    exit(1);
}
