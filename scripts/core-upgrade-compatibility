#!/usr/bin/env bash

set -euo pipefail

usage() {
  printf 'Usage: scripts/core-upgrade-compatibility --cache /absolute/path --output /absolute/path\n' >&2
  exit 64
}

die() {
  printf 'core-upgrade-compatibility: %s\n' "$*" >&2
  exit 1
}

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
FIXTURE="$ROOT/server/tests/fixtures/core-upgrade-compatibility"
METADATA="$FIXTURE/fixture.json"
COMPOSER_BIN="${PEANUT_COMPOSER:-composer}"
PHP_BIN="${PEANUT_PHP:-php}"
PNPM_BIN="${PEANUT_PNPM:-pnpm}"

cache_input=""
output_input=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --cache) [[ $# -ge 2 ]] || usage; cache_input="$2"; shift 2 ;;
    --output) [[ $# -ge 2 ]] || usage; output_input="$2"; shift 2 ;;
    *) usage ;;
  esac
done
[[ -n "$cache_input" && -n "$output_input" ]] || usage

canonical_empty_target() {
  local input="$1" label="$2" parent base physical
  [[ "$input" == /* ]] || die "$label must be absolute"
  parent="$(dirname "$input")"
  base="$(basename "$input")"
  [[ -d "$parent" ]] || die "$label parent does not exist: $parent"
  physical="$(cd "$parent" && pwd -P)/$base"
  if [[ -L "$input" ]]; then
    die "$label must not be a symlink: $input"
  fi
  if [[ -e "$physical" ]]; then
    [[ -d "$physical" ]] || die "$label must be a directory"
    [[ -z "$(find "$physical" -mindepth 1 -print -quit)" ]] || die "$label must be empty: $physical"
  fi
  printf '%s\n' "$physical"
}

CACHE="$(canonical_empty_target "$cache_input" cache)"
OUTPUT="$(canonical_empty_target "$output_input" output)"
[[ "$CACHE" != "$OUTPUT" ]] || die 'cache and output must differ'
case "$CACHE/" in "$OUTPUT/"*) die 'cache must not be inside output' ;; esac
case "$OUTPUT/" in "$CACHE/"*) die 'output must not be inside cache' ;; esac
mkdir -p "$CACHE" "$OUTPUT"

for command in git jq "$PHP_BIN" "$COMPOSER_BIN" "$PNPM_BIN" npm node; do
  command -v "$command" >/dev/null 2>&1 || die "required command is unavailable: $command"
done
jq -e '.schema_version == 1' "$METADATA" >/dev/null || die 'fixture metadata is invalid'

SOURCE_COMMIT="$(jq -r '.fixture.source_commit' "$METADATA")"
SOURCE_TREE="$(jq -r '.fixture.source_tree' "$METADATA")"
APP="$OUTPUT/application"
SOURCE="$CACHE/create-app-source"
CORE_MONOREPO="$CACHE/core-monorepo"
CORE_SPLIT="$CACHE/core-split"
COMPOSER_CACHE="$CACHE/composer"
PNPM_STORE="$CACHE/pnpm-store"
WORKTREE_ADDED=0

cleanup() {
  if [[ "$WORKTREE_ADDED" == 1 ]]; then
    git -C "$ROOT" worktree remove "$SOURCE" >/dev/null 2>&1 || true
  fi
}
trap cleanup EXIT INT TERM

[[ "$(git -C "$ROOT" rev-parse "${SOURCE_COMMIT}^{commit}")" == "$SOURCE_COMMIT" ]] || die 'create-app source commit is unavailable'
[[ "$(git -C "$ROOT" rev-parse "${SOURCE_COMMIT}^{tree}")" == "$SOURCE_TREE" ]] || die 'create-app source tree changed'
git -C "$ROOT" worktree add --detach "$SOURCE" "$SOURCE_COMMIT" >/dev/null
WORKTREE_ADDED=1

"$PHP_BIN" "$SOURCE/scripts/create-app" \
  --name="$(jq -r '.fixture.application_name' "$METADATA")" \
  --slug="$(jq -r '.fixture.slug' "$METADATA")" \
  --package="$(jq -r '.fixture.package_identity' "$METADATA")" \
  --target="$APP" >"$OUTPUT/create-app.json"

MANIFEST="$APP/.peanut/application-manifest.json"
[[ "$(jq -r '.template.version' "$MANIFEST")" == "$(jq -r '.fixture.template_version' "$METADATA")" ]] || die 'generated template version changed'
[[ "$(jq -r '.template.source_commit' "$MANIFEST")" == "$SOURCE_COMMIT" ]] || die 'generated source commit changed'
[[ "$(jq -r '.template.source_tree' "$MANIFEST")" == "$SOURCE_TREE" ]] || die 'generated source tree changed'
[[ "$(jq -r '.template.inventory_sha256' "$MANIFEST")" == "$(jq -r '.fixture.inventory_sha256' "$METADATA")" ]] || die 'generated inventory changed'

check_expected_digest() {
  local key="$1" actual="$2" expected
  expected="$(jq -r "$key" "$METADATA")"
  [[ "$expected" =~ ^[a-f0-9]{64}$ ]] || die "fixed digest is missing: $key"
  [[ "$expected" == "$actual" ]] || die "fixed digest mismatch: $key"
}

manifest_sha="$(shasum -a 256 "$MANIFEST" | awk '{print $1}')"
check_expected_digest '.fixture.generated_manifest_sha256' "$manifest_sha"
check_expected_digest '.fixture.managed_tree_sha256' "$(jq -r '.digests.managed_tree_sha256' "$MANIFEST")"
check_expected_digest '.fixture.app_owned_tree_sha256' "$(jq -r '.digests.app_owned_tree_sha256' "$MANIFEST")"

mkdir -p "$APP/server/tests/Productization" "$APP/web/src/core"
cp "$FIXTURE/php-probe.fixture" "$APP/server/tests/Productization/CoreUpgradeCompatibilityProbe.php"
cp "$FIXTURE/web-probe.ts" "$APP/web/src/core/core-upgrade-compatibility-probe.ts"

tree_digest() {
  local mode="$1"
  "$PHP_BIN" -r '
$root = $argv[1];
$mode = $argv[2];
$manifest = json_decode((string) file_get_contents($root . "/.peanut/application-manifest.json"), true, 512, JSON_THROW_ON_ERROR);
$allowed = ["server/composer.json", "server/composer.lock", "web/package.json", "web/pnpm-lock.yaml"];
$excludedSegments = ["vendor", "node_modules", "dist", "runtime", ".cache", ".pnpm-store"];
$paths = [];
if ($mode === "app-owned") {
    foreach ($manifest["files"] as $file) {
        if (($file["classification"] ?? null) === "app-owned") $paths[] = $file["path"];
    }
    $paths[] = "server/tests/Productization/CoreUpgradeCompatibilityProbe.php";
    $paths[] = "web/src/core/core-upgrade-compatibility-probe.ts";
} else {
    $iterator = new RecursiveIteratorIterator(new RecursiveDirectoryIterator($root, FilesystemIterator::SKIP_DOTS));
    foreach ($iterator as $file) {
        if (!$file->isFile() || $file->isLink()) continue;
        $path = str_replace(DIRECTORY_SEPARATOR, "/", substr($file->getPathname(), strlen($root) + 1));
        if (in_array($path, $allowed, true)) continue;
        $segments = explode("/", $path);
        if (array_intersect($excludedSegments, $segments) !== []) continue;
        $paths[] = $path;
    }
}
$rows = [];
foreach (array_values(array_unique($paths)) as $path) {
    $absolute = $root . "/" . $path;
    if (!is_file($absolute)) { fwrite(STDERR, "missing digest input: {$path}\n"); exit(1); }
    $rows[] = $path . "\0" . hash_file("sha256", $absolute);
}
sort($rows, SORT_STRING);
echo hash("sha256", implode("\n", $rows));
' "$APP" "$mode"
}

app_owned_before="$(tree_digest app-owned)"
source_before="$(tree_digest source)"
check_expected_digest '.fixture.app_owned_with_probes_sha256' "$app_owned_before"
check_expected_digest '.fixture.application_source_sha256' "$source_before"

set_json_version() {
  local manifest="$1" expression="$2" version="$3" temporary
  temporary="${manifest}.tmp"
  jq "$expression = \$version" --arg version "$version" "$manifest" >"$temporary"
  mv "$temporary" "$manifest"
}

assert_php_identity() {
  local version="$1" reference="$2"
  "$PHP_BIN" -r '
$lock = json_decode((string) file_get_contents($argv[1]), true, 512, JSON_THROW_ON_ERROR);
$wantedVersion = $argv[2]; $wantedReference = $argv[3];
foreach ($lock["packages"] as $package) {
    if (($package["name"] ?? null) !== "peanut-admin/core") continue;
    if (($package["version"] ?? null) !== $wantedVersion
        || ($package["dist"]["reference"] ?? null) !== $wantedReference
        || ($package["source"]["reference"] ?? null) !== $wantedReference) exit(1);
    exit(0);
}
exit(1);
' "$APP/server/composer.lock" "$version" "$reference" || die "Composer lock identity mismatch for $version"
  "$PHP_BIN" -r '
$installed = json_decode((string) file_get_contents($argv[1]), true, 512, JSON_THROW_ON_ERROR);
$packages = $installed["packages"] ?? $installed;
foreach ($packages as $package) {
    if (($package["name"] ?? null) === "peanut-admin/core"
        && ($package["version"] ?? null) === $argv[2]
        && ($package["dist"]["reference"] ?? null) === $argv[3]) exit(0);
}
exit(1);
' "$APP/server/vendor/composer/installed.json" "$version" "$reference" || die "installed Composer identity mismatch for $version"
}

assert_web_identity() {
  local version="$1" integrity="$2"
  [[ "$(jq -r '.version' "$APP/web/node_modules/@peanut-admin/admin/package.json")" == "$version" ]] || die "installed npm version mismatch for $version"
  rg -F "resolution: {integrity: $integrity}" "$APP/web/pnpm-lock.yaml" >/dev/null || die "pnpm integrity mismatch for $version"
}

php_public_entry_gate() {
  local phase="$1" php_manifest="$APP/server/vendor/peanut-admin/core/composer.json"
  "$PHP_BIN" -r '
$root = $argv[1]; $manifest = json_decode((string) file_get_contents($argv[2]), true, 512, JSON_THROW_ON_ERROR);
$prefixes = array_keys($manifest["autoload"]["psr-4"] ?? []);
$iterator = new RecursiveIteratorIterator(new RecursiveDirectoryIterator($root . "/server", FilesystemIterator::SKIP_DOTS));
foreach ($iterator as $file) {
    if (!$file->isFile() || $file->getExtension() !== "php" || str_contains($file->getPathname(), "/vendor/")) continue;
    $content = (string) file_get_contents($file->getPathname());
    if (preg_match("#(?:vendor/peanut-admin|packages/php|peanut-admin/core/.*/src/)#i", $content)) exit(1);
    preg_match_all("/\\b(?:use|new|extends|implements|instanceof)\\s+(PeanutAdmin\\\\[A-Za-z0-9_\\\\]+)/", $content, $matches);
    foreach ($matches[1] as $class) {
        $ok = false;
        foreach ($prefixes as $prefix) if (str_starts_with($class . "\\\\", $prefix)) { $ok = true; break; }
        if (!$ok) { fwrite(STDERR, "undeclared Composer namespace: {$class}\n"); exit(1); }
    }
}
' "$APP" "$php_manifest" || die "Composer public namespace gate failed during $phase"
  jq -S '.autoload["psr-4"] | keys' "$php_manifest" >"$OUTPUT/${phase}-composer-namespaces.json"
  printf '%s\n' "$phase" >"$OUTPUT/public-entry-${phase}.passed"
}

web_public_entry_gate() {
  local phase="$1" npm_manifest="$APP/web/node_modules/@peanut-admin/admin/package.json"
  node - "$APP" "$npm_manifest" <<'NODE'
const fs = require('node:fs');
const path = require('node:path');
const root = process.argv[2];
const manifest = JSON.parse(fs.readFileSync(process.argv[3], 'utf8'));
const exportsSet = new Set(Object.keys(manifest.exports || {}).map((key) => key === '.' ? '@peanut-admin/admin' : `@peanut-admin/admin${key.slice(1)}`));
const roots = ['web/src', 'web/tests', 'pc', 'uniapp/src'];
const ignored = new Set(['node_modules', 'dist', '.nuxt', '.output']);
function visit(current) {
  if (!fs.existsSync(current)) return;
  const stat = fs.lstatSync(current);
  if (stat.isSymbolicLink()) throw new Error(`symlink not allowed in source scan: ${current}`);
  if (stat.isDirectory()) {
    for (const entry of fs.readdirSync(current)) if (!ignored.has(entry)) visit(path.join(current, entry));
    return;
  }
  if (!/\.(?:ts|tsx|js|jsx|vue|mjs|cjs)$/.test(current)) return;
  const content = fs.readFileSync(current, 'utf8');
  if (/node_modules\/@peanut-admin|@peanut-admin\/admin\/.*\/src(?:\/|['"])/.test(content)) throw new Error(`npm internal path: ${current}`);
  if (/from\s+['"]\.\.\/.*packages\/web|import\s*\(\s*['"]\.\.\/.*packages\/web/.test(content)) throw new Error(`relative cross-package source import: ${current}`);
  const imports = content.matchAll(/(?:from\s+|import\s*\(\s*|require\s*\(\s*|import\s+)['"](@peanut-admin\/admin(?:\/[^'"]+)?)['"]/g);
  for (const match of imports) if (!exportsSet.has(match[1])) throw new Error(`undeclared npm export ${match[1]} in ${current}`);
}
for (const relative of roots) visit(path.join(root, relative));
NODE
  jq -S '.exports | keys' "$npm_manifest" >"$OUTPUT/${phase}-npm-exports.json"
  printf '%s\n' "$phase" >"$OUTPUT/public-entry-${phase}.passed"
}

run_php_phase() {
  local phase="$1" version="$2" reference="$3"
  COMPOSER_CACHE_DIR="$COMPOSER_CACHE" "$COMPOSER_BIN" install --working-dir "$APP/server" --no-interaction --no-progress --prefer-dist
  assert_php_identity "$version" "$reference"
  "$PHP_BIN" "$APP/server/tests/Productization/CoreUpgradeCompatibilityProbe.php"
  "$PHP_BIN" "$APP/server/tests/Productization/AdminPermissionHostTest.php"
  php_public_entry_gate "$phase"
}

run_web_phase() {
  local phase="$1" version="$2" integrity="$3"
  (cd "$APP/web" && HUSKY=0 "$PNPM_BIN" install --frozen-lockfile --store-dir "$PNPM_STORE")
  assert_web_identity "$version" "$integrity"
  (cd "$APP/web" && "$PNPM_BIN" run type:check && "$PNPM_BIN" run build)
  web_public_entry_gate "$phase"
}

php_old="$(jq -r '.php.old_version' "$METADATA")"
php_old_ref="$(jq -r '.php.old_source_reference' "$METADATA")"
php_new="$(jq -r '.php.new_version' "$METADATA")"
php_new_ref="$(jq -r '.php.new_source_reference' "$METADATA")"
web_old="$(jq -r '.web.old_version' "$METADATA")"
web_old_integrity="$(jq -r '.web.old_integrity' "$METADATA")"
web_new="$(jq -r '.web.new_version' "$METADATA")"
web_new_integrity="$(jq -r '.web.new_integrity' "$METADATA")"

set_json_version "$APP/server/composer.json" '.require["peanut-admin/core"]' "$php_old"
cp "$FIXTURE/composer-alpha2.lock" "$APP/server/composer.lock"
set_json_version "$APP/web/package.json" '.dependencies["@peanut-admin/admin"]' "$web_old"
cp "$FIXTURE/pnpm-alpha4-lock.yaml" "$APP/web/pnpm-lock.yaml"
run_php_phase php-alpha2 "$php_old" "$php_old_ref"
run_web_phase web-alpha4 "$web_old" "$web_old_integrity"

old_app_owned="$(tree_digest app-owned)"
old_source="$(tree_digest source)"
[[ "$old_app_owned" == "$app_owned_before" && "$old_source" == "$source_before" ]] || die 'old consumer phase changed application-owned or business source'

set_json_version "$APP/server/composer.json" '.require["peanut-admin/core"]' "$php_new"
cp "$FIXTURE/composer-alpha5.lock" "$APP/server/composer.lock"
set_json_version "$APP/web/package.json" '.dependencies["@peanut-admin/admin"]' "$web_new"
cp "$FIXTURE/pnpm-alpha5-lock.yaml" "$APP/web/pnpm-lock.yaml"
run_php_phase php-alpha5 "$php_new" "$php_new_ref"
run_web_phase web-alpha5 "$web_new" "$web_new_integrity"

new_app_owned="$(tree_digest app-owned)"
new_source="$(tree_digest source)"
[[ "$new_app_owned" == "$app_owned_before" && "$new_source" == "$source_before" ]] || die 'upgrade changed application-owned or business source'
jq -e --slurp '.[0] - .[1] == []' \
  "$OUTPUT/php-alpha2-composer-namespaces.json" \
  "$OUTPUT/php-alpha5-composer-namespaces.json" >/dev/null || die 'alpha.5 removed an alpha.2 public Composer namespace'
jq -e --slurp '.[0] - .[1] == []' \
  "$OUTPUT/web-alpha4-npm-exports.json" \
  "$OUTPUT/web-alpha5-npm-exports.json" >/dev/null || die 'alpha.5 removed an alpha.4 installed npm export'

git init -q "$CORE_MONOREPO"
git -C "$CORE_MONOREPO" remote add origin https://github.com/peanut-opensource/peanut-admin.git
git -C "$CORE_MONOREPO" fetch -q --depth=1 origin tag v0.1.0-alpha.4 tag v0.1.0-alpha.5
alpha4_tag="$(jq -r '.known_release_identity_defect.tag_object' "$METADATA")"
alpha4_commit="$(jq -r '.known_release_identity_defect.commit' "$METADATA")"
alpha4_tree="$(jq -r '.known_release_identity_defect.tree' "$METADATA")"
[[ "$(git -C "$CORE_MONOREPO" rev-parse v0.1.0-alpha.4)" == "$alpha4_tag" ]] || die 'core alpha.4 tag object changed'
[[ "$(git -C "$CORE_MONOREPO" rev-parse v0.1.0-alpha.4^{commit})" == "$alpha4_commit" ]] || die 'core alpha.4 commit changed'
[[ "$(git -C "$CORE_MONOREPO" rev-parse v0.1.0-alpha.4^{tree})" == "$alpha4_tree" ]] || die 'core alpha.4 tree changed'
embedded_alpha4="$(git -C "$CORE_MONOREPO" show v0.1.0-alpha.4:packages/php/composer.json | jq -r '.version')"
[[ "$embedded_alpha4" == "$(jq -r '.known_release_identity_defect.embedded_package_version' "$METADATA")" ]] || die 'recorded alpha.4 embedded PHP identity changed'
if COMPOSER_CACHE_DIR="$COMPOSER_CACHE" "$COMPOSER_BIN" show peanut-admin/core 0.1.0-alpha.4 --all --format=json >/dev/null 2>&1; then
  die 'Packagist unexpectedly exposes alpha.4; release identity policy and fixture require review'
fi

alpha5_tag="$(jq -r '.php.new_monorepo_tag_object' "$METADATA")"
alpha5_commit="$(jq -r '.php.new_monorepo_commit' "$METADATA")"
alpha5_tree="$(jq -r '.php.new_monorepo_tree' "$METADATA")"
[[ "$(git -C "$CORE_MONOREPO" rev-parse v0.1.0-alpha.5)" == "$alpha5_tag" ]] || die 'core alpha.5 tag object changed'
[[ "$(git -C "$CORE_MONOREPO" rev-parse v0.1.0-alpha.5^{commit})" == "$alpha5_commit" ]] || die 'core alpha.5 commit changed'
[[ "$(git -C "$CORE_MONOREPO" rev-parse v0.1.0-alpha.5^{tree})" == "$alpha5_tree" ]] || die 'core alpha.5 tree changed'
[[ "$(git -C "$CORE_MONOREPO" show v0.1.0-alpha.5:packages/php/composer.json | jq -r '.version')" == "$php_new" ]] || die 'core alpha.5 embedded PHP package version mismatches its release tag'

git init -q "$CORE_SPLIT"
git -C "$CORE_SPLIT" remote add origin https://github.com/peanut-opensource/peanut-admin-core.git
git -C "$CORE_SPLIT" fetch -q --depth=1 origin tag v0.1.0-alpha.2 tag v0.1.0-alpha.5
for side in old new; do
  version="$(jq -r ".php.${side}_version" "$METADATA")"
  tag_object="$(jq -r ".php.${side}_split_tag_object" "$METADATA")"
  commit="$(jq -r ".php.${side}_split_commit" "$METADATA")"
  tree="$(jq -r ".php.${side}_split_tree" "$METADATA")"
  [[ "$(git -C "$CORE_SPLIT" rev-parse "v${version}")" == "$tag_object" ]] || die "Composer split tag object changed for $version"
  [[ "$(git -C "$CORE_SPLIT" rev-parse "v${version}^{commit}")" == "$commit" ]] || die "Composer split commit changed for $version"
  [[ "$(git -C "$CORE_SPLIT" rev-parse "v${version}^{tree}")" == "$tree" ]] || die "Composer split tree changed for $version"
  [[ "$(git -C "$CORE_SPLIT" show "v${version}:composer.json" | jq -r '.version')" == "$version" ]] || die "Composer split metadata mismatches tag $version"
done

for side in old new; do
  version="$(jq -r ".php.${side}_version" "$METADATA")"
  reference="$(jq -r ".php.${side}_source_reference" "$METADATA")"
  packagist_identity="$OUTPUT/packagist-${version}.json"
  COMPOSER_CACHE_DIR="$COMPOSER_CACHE" "$COMPOSER_BIN" show peanut-admin/core "$version" --all --format=json >"$packagist_identity"
  jq -e --arg version "$version" --arg reference "$reference" \
    '.versions == [$version] and .source.reference == $reference and .dist.reference == $reference' \
    "$packagist_identity" >/dev/null || die "Packagist identity mismatches monorepo/split release identity for $version"
done

old_exports="$OUTPUT/npm-alpha4-exports.json"
new_exports="$OUTPUT/npm-alpha5-exports.json"
npm view "@peanut-admin/admin@${web_old}" exports --json | jq -S 'keys' >"$old_exports"
npm view "@peanut-admin/admin@${web_new}" exports --json | jq -S 'keys' >"$new_exports"
jq -e --slurp '.[0] - .[1] == []' "$old_exports" "$new_exports" >/dev/null || die 'alpha.5 removed an alpha.4 public npm export'
for side in old new; do
  version="$(jq -r ".web.${side}_version" "$METADATA")"
  integrity="$(jq -r ".web.${side}_integrity" "$METADATA")"
  shasum="$(jq -r ".web.${side}_shasum" "$METADATA")"
  npm_identity="$OUTPUT/npm-${version}.json"
  npm view "@peanut-admin/admin@${version}" version dist.integrity dist.shasum --json >"$npm_identity"
  jq -e --arg version "$version" --arg integrity "$integrity" --arg shasum "$shasum" \
    '.version == $version and .["dist.integrity"] == $integrity and .["dist.shasum"] == $shasum' \
    "$npm_identity" >/dev/null || die "npm Registry identity changed for $version"
done

"$PHP_BIN" -r '
$metadata = json_decode((string) file_get_contents($argv[1]), true, 512, JSON_THROW_ON_ERROR);
$summary = [
  "schema_version" => 1,
  "status" => "passed",
  "fixture" => [
    "template_version" => $metadata["fixture"]["template_version"],
    "source_commit" => $metadata["fixture"]["source_commit"],
    "source_tree" => $metadata["fixture"]["source_tree"],
    "generated_manifest_sha256" => $argv[3],
    "application_source_sha256" => $argv[4],
    "app_owned_with_probes_sha256" => $argv[5],
  ],
  "php" => [
    "old" => $metadata["php"]["old_version"], "old_source_reference" => $metadata["php"]["old_source_reference"],
    "new" => $metadata["php"]["new_version"], "new_source_reference" => $metadata["php"]["new_source_reference"],
    "old_split_commit" => $metadata["php"]["old_split_commit"], "new_split_commit" => $metadata["php"]["new_split_commit"],
    "status" => "passed",
  ],
  "web" => [
    "old" => $metadata["web"]["old_version"], "new" => $metadata["web"]["new_version"],
    "old_integrity" => $metadata["web"]["old_integrity"], "old_shasum" => $metadata["web"]["old_shasum"],
    "new_integrity" => $metadata["web"]["new_integrity"], "new_shasum" => $metadata["web"]["new_shasum"],
    "status" => "passed",
  ],
  "public_entry_gate" => "passed",
  "source_diff_gate" => "passed",
  "known_php_release_identity_defect" => $metadata["known_release_identity_defect"],
  "not_covered" => ["database", "services", "ports", "containers", "browser", "full PC build", "full UniApp build", "publication"],
];
file_put_contents($argv[2], json_encode($summary, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR) . "\n");
' "$METADATA" "$OUTPUT/summary.json" "$manifest_sha" "$source_before" "$app_owned_before"

printf 'CORE-UPGRADE-COMPATIBILITY-001 passed; summary=%s\n' "$OUTPUT/summary.json"
