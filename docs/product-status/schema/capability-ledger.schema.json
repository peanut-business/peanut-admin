{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://peanut-admin.local/schema/capability-ledger.schema.json",
  "title": "Peanut Admin product capability ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "title",
    "visibility",
    "facts_baseline",
    "overall",
    "capabilities"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "title": {"type": "string", "minLength": 1},
    "visibility": {"const": "internal"},
    "facts_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch", "commit", "reviewed_at"],
      "properties": {
        "branch": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "reviewed_at": {"type": "string", "format": "date"}
      }
    },
    "overall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "summary"],
      "properties": {
        "id": {"type": "string", "pattern": "^PA-[A-Z0-9]+-[0-9]{3}$"},
        "status": {"$ref": "#/$defs/status"},
        "summary": {"type": "string", "minLength": 1}
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/capability"}
    }
  },
  "$defs": {
    "status": {
      "enum": [
        "planned",
        "in_progress",
        "implemented",
        "verified",
        "blocked",
        "deferred",
        "out_of_scope",
        "retired"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref"],
      "properties": {
        "kind": {
          "enum": [
            "ci",
            "document",
            "git",
            "pull_request",
            "release",
            "report",
            "resource",
            "tag"
          ]
        },
        "ref": {"type": "string", "minLength": 1}
      }
    },
    "deferral": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "resume_when"],
      "properties": {
        "reason": {"type": "string", "minLength": 1},
        "resume_when": {"type": "string", "minLength": 1}
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "area",
        "status",
        "summary",
        "acceptance",
        "evidence"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^PA-[A-Z0-9]+-[0-9]{3}$"},
        "name": {"type": "string", "minLength": 1},
        "area": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "status": {"$ref": "#/$defs/status"},
        "summary": {"type": "string", "minLength": 1},
        "acceptance": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/evidence"}
        },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^PA-[A-Z0-9]+-[0-9]{3}$"}
        },
        "blockers": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "deferral": {"$ref": "#/$defs/deferral"},
        "paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
