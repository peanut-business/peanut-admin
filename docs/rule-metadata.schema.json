{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "repo://peanut-admin/docs/rule-metadata.schema.json",
  "title": "Peanut Admin versioned rule metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "revision", "kind", "authority", "scope", "status", "effective_at", "supersedes", "source", "owner", "source_span", "validation"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$"},
    "revision": {"type": "integer", "minimum": 1},
    "kind": {"enum": ["project-policy", "product-contract", "observation", "projection", "method"]},
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "issuer", "decision_ref"],
      "properties": {
        "kind": {"enum": ["platform-system", "platform-developer", "user-decision", "user-default", "project-policy", "product-contract", "observation", "projection", "method"]},
        "issuer": {"type": "string", "minLength": 1},
        "decision_ref": {"type": ["string", "null"]}
      }
    },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "subject", "modes", "actions", "exclusions"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "subject": {"type": "string", "minLength": 1},
        "modes": {"type": "array", "uniqueItems": true, "items": {"enum": ["review", "development", "qualification", "release", "instance"]}},
        "actions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "exclusions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "status": {"enum": ["proposed", "active", "superseded", "retired"]},
    "effective_at": {
      "type": "object", "additionalProperties": false,
      "required": ["value", "precision"],
      "properties": {
        "value": {"type": "string", "minLength": 10},
        "precision": {"enum": ["timestamp", "date"]}
      }
    },
    "supersedes": {"type": "array", "items": {"$ref": "#/$defs/supersedesEdge"}},
    "source": {"$ref": "#/$defs/source"},
    "owner": {"type": "string", "minLength": 1},
    "source_span": {"type": "string", "minLength": 1},
    "validation": {"type": "string", "minLength": 1},
    "normative_sources": {"type": "array", "items": {"$ref": "#/$defs/reference"}},
    "observes": {"type": "array", "items": {"$ref": "#/$defs/reference"}},
    "historical_sources": {"type": "array", "items": {"$ref": "#/$defs/reference"}},
    "retired_reason": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "uri", "locator", "revision", "sha256"],
      "properties": {
        "kind": {"enum": ["repository-file", "external-repository-file", "user-decision", "sealed-evidence"]},
        "uri": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "supersedesEdge": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "revision", "scope"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "revision": {"type": "integer", "minimum": 1},
        "scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "reference": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "target"],
      "properties": {
        "kind": {"enum": ["rule", "document", "path", "external"]},
        "target": {"type": "string", "minLength": 1},
        "revision": {"type": ["integer", "string", "null"]},
        "digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
