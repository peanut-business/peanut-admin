{
  "schema_version": 1,
  "classifications": {
    "none": "No public contract or maintained fact changed; record the reason.",
    "technical": "Update the affected technical explanation or authoritative index.",
    "developer-site": "Update the public task-oriented projection after its upstream fact.",
    "generated": "Regenerate checked-in projections; never edit them directly.",
    "architecture-decision": "Record the boundary or trade-off decision before changing projections."
  },
  "rules": [
    {
      "id": "internal-refactor",
      "paths": ["server/app/**/*.php", "web/src/**/*", "platform/src/**/*", "pc/**/*", "uniapp/src/**/*"],
      "classifications": ["none"],
      "upstream": ["changed implementation"],
      "technical_docs": [],
      "site_docs": [],
      "generated": [],
      "reason": "Default only when behavior, contract, owner, command, configuration, and architecture stay unchanged; a more specific rule wins."
    },
    {
      "id": "http-api",
      "paths": ["server/route/**/*.php", "server/app/**/*Controller.php", "docs/api/openapi.yaml", "scripts/check-openapi"],
      "classifications": ["technical", "developer-site", "generated"],
      "upstream": ["server routes/controllers", "docs/api/openapi.yaml"],
      "technical_docs": ["docs/api/openapi.yaml", "docs/peanut-admin-development-guide.md"],
      "site_docs": ["docs-site/api.md"],
      "generated": ["generated OpenAPI or route projections when present"],
      "reason": "Public HTTP shape and examples must follow the route/OpenAPI authority."
    },
    {
      "id": "cli-command",
      "paths": ["scripts/*", "server/think", "server/app/**/command/**/*.php"],
      "classifications": ["technical", "developer-site"],
      "upstream": ["executable command and --help output"],
      "technical_docs": ["docs/peanut-admin-development-guide.md", "docs/release-engineering.md"],
      "site_docs": ["docs-site/getting-started.md", "docs-site/reference.md"],
      "generated": [],
      "reason": "Only pages that name the changed command are in scope."
    },
    {
      "id": "schema-migration-owner",
      "paths": ["server/database/**/*.sql", "server/database/**/*.php", "server/app/**/model/**/*.php", "server/app/**/module.json"],
      "classifications": ["technical", "developer-site", "architecture-decision"],
      "upstream": ["KernelSchema", "server/database/init.sql", "migration files", "module.json"],
      "technical_docs": ["docs/architecture/core-application-capability-graph.md", "docs/architecture/service-layer-registry.md"],
      "site_docs": ["docs-site/guide/data-permissions-tenancy.md", "docs-site/guide/deployment-upgrade.md"],
      "generated": [],
      "reason": "Data owner or upgrade behavior changes require an explicit boundary decision."
    },
    {
      "id": "module-manifest",
      "paths": ["server/app/Modules/**/module.json", "server/app/Modules/**/Module.php"],
      "classifications": ["technical", "developer-site"],
      "upstream": ["module.json", "module bootstrap"],
      "technical_docs": ["docs/module-development-guide.md", "docs/architecture/module-execution-context-contract.md"],
      "site_docs": ["docs-site/guide/module-development.md"],
      "generated": [],
      "reason": "Module identity, ownership, permission and lifecycle projections follow the manifest."
    },
    {
      "id": "resource-environment",
      "paths": ["resources/project-resources.json", "resources/p0e-runtime-qualification.json", "scripts/local-stack.sh", ".local/stack.env.example"],
      "classifications": ["technical", "developer-site", "generated"],
      "upstream": ["resources/project-resources.json"],
      "technical_docs": ["docs/development-database-resource.md", "AGENTS.md"],
      "site_docs": ["docs-site/getting-started.md", "docs-site/troubleshooting.md"],
      "generated": ["public-safe source map only; never project credential references or internal addresses"],
      "reason": "Resource facts stay internal; only safe local-development instructions are projected."
    },
    {
      "id": "capability-status",
      "paths": ["docs/product-status/capability-ledger.json", "docs/product-status/releases/*.json", "docs/product-status/deployments/*.json"],
      "classifications": ["technical", "generated"],
      "upstream": ["docs/product-status/capability-ledger.json", "release/deployment snapshots"],
      "technical_docs": ["docs/product-status/README.md"],
      "site_docs": [],
      "generated": ["public documentation source map when its source relationship changes"],
      "reason": "Internal status and candidate evidence are not published to the developer site."
    },
    {
      "id": "architecture-boundary",
      "paths": ["resources/service-registry.json", "docs/architecture/*.md", "docs/design/**/*.md", "server/app/Modules/**/module.json", "server/vendor/peanut-admin/core/**/*", "web/node_modules/@peanut-admin/admin/**/*"],
      "classifications": ["architecture-decision", "technical", "developer-site"],
      "upstream": ["accepted ADR or architecture contract", "service registry", "module manifests", "fixed Core dependency identity"],
      "technical_docs": ["docs/architecture/core-application-capability-graph.md", "docs/architecture/pb03-ownership-and-migration-gates.md"],
      "site_docs": ["docs-site/guide/development.md", "docs-site/guide/module-development.md"],
      "generated": [],
      "reason": "Application/Core ownership changes are decisions, not incidental documentation edits."
    },
    {
      "id": "documentation-governance",
      "paths": ["docs/document-registry.json", "docs/document-impact-map.json", "docs/governance/**/*.md", "scripts/docs-governance", "docs-site/.vitepress/config.ts"],
      "classifications": ["technical", "developer-site", "generated"],
      "upstream": ["documentation registries"],
      "technical_docs": ["docs/README.md", "docs/governance/authoritative-source-map.md"],
      "site_docs": ["docs-site/index.md", "docs-site/reference/source-map.generated.md"],
      "generated": ["docs/reference/document-catalog.generated.md", "docs-site/reference/source-map.generated.md"],
      "reason": "The governance graph and its generated views move together."
    }
  ],
  "scenarios": [
    {"id": "internal-refactor", "path": "server/app/common/service/ExampleService.php", "must_include": ["none"], "must_not_include": ["developer-site"]},
    {"id": "http-api", "path": "server/app/adminapi/controller/ExampleController.php", "must_include": ["technical", "developer-site", "generated"], "must_not_include": ["none"]},
    {"id": "cli-command", "path": "scripts/example-command", "must_include": ["technical", "developer-site"], "must_not_include": ["architecture-decision"]},
    {"id": "schema-owner", "path": "server/database/migrations/20260827-example.sql", "must_include": ["technical", "developer-site", "architecture-decision"], "must_not_include": ["none"]},
    {"id": "module-manifest", "path": "server/app/Modules/Official/Article/module.json", "must_include": ["technical", "developer-site"], "must_not_include": ["none"]},
    {"id": "resource-change", "path": "resources/project-resources.json", "must_include": ["technical", "developer-site", "generated"], "must_not_include": ["none"]},
    {"id": "capability-status", "path": "docs/product-status/capability-ledger.json", "must_include": ["technical", "generated"], "must_not_include": ["developer-site"]},
    {"id": "architecture-boundary", "path": "resources/service-registry.json", "must_include": ["architecture-decision", "technical", "developer-site"], "must_not_include": ["none"]}
  ]
}
