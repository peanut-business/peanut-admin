{
  "schema_version": 1,
  "repository": "peanut-admin",
  "authority": "This registry classifies documentation; it does not replace product, resource, module, service, schema, API, or release fact sources.",
  "enums": {
    "audience": ["maintainer", "architect", "ai", "developer", "operator", "user"],
    "content_type": ["index", "source-map", "architecture", "guide", "reference", "plan", "decision", "evidence", "archive", "generated", "public-projection"],
    "status": ["authoritative", "current", "planned", "deprecated", "archived", "generated"],
    "scope": ["application", "core", "docs-site"]
  },
  "documents": [
    {
      "id": "pa-docs-index",
      "path": "docs/README.md",
      "title": "Peanut Admin technical documentation",
      "audience": ["maintainer", "architect", "ai"],
      "content_type": "index",
      "authority": "canonical-index",
      "canonical_sources": ["docs/document-registry.json"],
      "owner": "documentation-architecture",
      "status": "authoritative",
      "scope": ["application"],
      "related": ["documentation"],
      "site_projections": ["pa-site-index"],
      "replaced_by": null,
      "validation": "./scripts/docs-governance check"
    },
    {
      "id": "pa-docs-source-map",
      "path": "docs/governance/authoritative-source-map.md",
      "title": "Authoritative source map",
      "audience": ["maintainer", "architect", "ai"],
      "content_type": "source-map",
      "authority": "canonical-index",
      "canonical_key": "documentation-authoritative-source-map",
      "canonical_sources": ["docs/document-registry.json", "docs/document-impact-map.json"],
      "owner": "documentation-architecture",
      "status": "authoritative",
      "scope": ["application", "core", "docs-site"],
      "related": ["resources", "capabilities", "modules", "services", "schema", "api", "release"],
      "site_projections": ["pa-site-source-map"],
      "replaced_by": null,
      "validation": "./scripts/docs-governance check"
    },
    {
      "id": "pa-docs-lifecycle",
      "path": "docs/governance/document-lifecycle.md",
      "title": "Document lifecycle and authoring rules",
      "audience": ["maintainer", "architect", "ai"],
      "content_type": "guide",
      "authority": "interpretation",
      "canonical_sources": ["docs/document-registry.json"],
      "owner": "documentation-architecture",
      "status": "current",
      "scope": ["application", "core", "docs-site"],
      "related": ["documentation"],
      "site_projections": [],
      "replaced_by": null,
      "validation": "./scripts/docs-governance check"
    },
    {
      "id": "pa-docs-impact-policy",
      "path": "docs/governance/docs-impact.md",
      "title": "Documentation impact policy",
      "audience": ["maintainer", "architect", "ai", "developer"],
      "content_type": "guide",
      "authority": "interpretation",
      "canonical_sources": ["docs/document-impact-map.json"],
      "owner": "documentation-architecture",
      "status": "current",
      "scope": ["application", "core", "docs-site"],
      "related": ["documentation", "change-management"],
      "site_projections": [],
      "replaced_by": null,
      "validation": "./scripts/docs-governance scenarios"
    },
    {
      "id": "pa-docs-change-scenarios",
      "path": "docs/governance/change-scenarios.md",
      "title": "Documentation change scenarios",
      "audience": ["maintainer", "architect", "ai"],
      "content_type": "reference",
      "authority": "generated-contract",
      "canonical_sources": ["docs/document-impact-map.json"],
      "owner": "documentation-architecture",
      "status": "current",
      "scope": ["application", "docs-site"],
      "related": ["documentation", "acceptance"],
      "site_projections": [],
      "replaced_by": null,
      "validation": "./scripts/docs-governance scenarios"
    },
    {
      "id": "pa-docs-template",
      "path": "docs/governance/templates/document-template.md",
      "title": "Technical document template",
      "audience": ["maintainer", "architect", "ai"],
      "content_type": "reference",
      "authority": "template",
      "canonical_sources": ["docs/governance/document-lifecycle.md"],
      "owner": "documentation-architecture",
      "status": "current",
      "scope": ["application", "core"],
      "related": ["documentation"],
      "site_projections": [],
      "replaced_by": null,
      "validation": "manual: copy only for a new governed document"
    },
    {
      "id": "pa-docs-pr-checklist",
      "path": "docs/governance/templates/docs-impact-checklist.md",
      "title": "Documentation impact checklist",
      "audience": ["maintainer", "developer", "ai"],
      "content_type": "reference",
      "authority": "template",
      "canonical_sources": ["docs/governance/docs-impact.md"],
      "owner": "documentation-architecture",
      "status": "current",
      "scope": ["application", "core", "docs-site"],
      "related": ["documentation", "pull-request"],
      "site_projections": [],
      "replaced_by": null,
      "validation": "manual: include in task or PR description"
    },
    {
      "id": "pa-docs-catalog",
      "path": "docs/reference/document-catalog.generated.md",
      "title": "Generated document catalog",
      "audience": ["maintainer", "architect", "ai"],
      "content_type": "generated",
      "authority": "generated",
      "canonical_sources": ["docs/document-registry.json"],
      "owner": "documentation-architecture",
      "status": "generated",
      "scope": ["application"],
      "related": ["documentation"],
      "site_projections": [],
      "replaced_by": null,
      "validation": "./scripts/docs-governance generate --check"
    },
    {
      "id": "pa-site-index",
      "path": "docs-site/index.md",
      "title": "Developer documentation home",
      "audience": ["developer", "operator", "user"],
      "content_type": "public-projection",
      "authority": "projection",
      "canonical_sources": ["docs/README.md", "docs/governance/authoritative-source-map.md"],
      "owner": "developer-experience",
      "status": "current",
      "scope": ["docs-site"],
      "related": ["documentation"],
      "site_projections": [],
      "replaced_by": null,
      "validation": "cd docs-site && pnpm build"
    },
    {
      "id": "pa-site-getting-started",
      "path": "docs-site/getting-started.md",
      "title": "Quick start",
      "audience": ["developer"],
      "content_type": "public-projection",
      "authority": "projection",
      "canonical_sources": ["scripts/create-app", "scripts/local-stack.sh", "server/.env.example"],
      "owner": "developer-experience",
      "status": "current",
      "scope": ["docs-site"],
      "related": ["local-development", "installation"],
      "site_projections": [],
      "replaced_by": null,
      "validation": "cd docs-site && pnpm build"
    },
    {
      "id": "pa-site-source-map",
      "path": "docs-site/reference/source-map.generated.md",
      "title": "Public documentation source map",
      "audience": ["developer", "ai"],
      "content_type": "generated",
      "authority": "generated",
      "canonical_sources": ["docs/document-registry.json"],
      "owner": "developer-experience",
      "status": "generated",
      "scope": ["docs-site"],
      "related": ["documentation"],
      "site_projections": [],
      "replaced_by": null,
      "validation": "./scripts/docs-governance generate --check"
    }
  ],
  "collections": [
    {
      "id": "pa-architecture-contracts",
      "include": ["docs/architecture/*.md"],
      "audience": ["maintainer", "architect", "ai"],
      "content_type": "architecture",
      "owner": "architecture",
      "status": "current",
      "scope": ["application"],
      "visibility": "internal"
    },
    {
      "id": "pa-design-roadmap",
      "include": ["docs/design/**/*.md", "docs/design/*.md", "docs/plans/*.md"],
      "audience": ["maintainer", "architect", "ai"],
      "content_type": "plan",
      "owner": "product-architecture",
      "status": "planned",
      "scope": ["application"],
      "visibility": "internal"
    },
    {
      "id": "pa-product-evidence",
      "include": ["docs/product-status/**/*.md", "docs/product-status/*.md", "docs/*-report.md", "docs/*-RESULT.md", "docs/*-prompt.md"],
      "audience": ["maintainer", "ai"],
      "content_type": "evidence",
      "owner": "release-qualification",
      "status": "archived",
      "scope": ["application"],
      "visibility": "internal"
    },
    {
      "id": "pa-operations-guides",
      "include": ["docs/operations/*.md", "docs/development/*.md", "docs/testing/*.md", "docs/maintenance/*.md"],
      "audience": ["maintainer", "operator", "ai"],
      "content_type": "guide",
      "owner": "application-maintainers",
      "status": "current",
      "scope": ["application"],
      "visibility": "internal"
    },
    {
      "id": "pa-legacy-technical",
      "include": ["docs/*.md"],
      "audience": ["maintainer", "architect", "ai"],
      "content_type": "reference",
      "owner": "application-maintainers",
      "status": "current",
      "scope": ["application"],
      "visibility": "internal"
    },
    {
      "id": "pa-public-site-pages",
      "include": ["docs-site/*.md", "docs-site/**/*.md"],
      "audience": ["developer", "operator", "user"],
      "content_type": "public-projection",
      "owner": "developer-experience",
      "status": "current",
      "scope": ["docs-site"],
      "visibility": "public"
    },
    {
      "id": "pa-governance-docs",
      "include": ["docs/governance/*.md", "docs/governance/**/*.md"],
      "audience": ["maintainer", "architect", "ai"],
      "content_type": "guide",
      "owner": "documentation-architecture",
      "status": "current",
      "scope": ["application"],
      "visibility": "internal"
    },
    {
      "id": "pa-reference-docs",
      "include": ["docs/reference/*.md", "docs/reference/**/*.md"],
      "audience": ["maintainer", "architect", "ai"],
      "content_type": "reference",
      "owner": "documentation-architecture",
      "status": "current",
      "scope": ["application"],
      "visibility": "internal"
    }
  ],
  "external_repositories": {
    "peanut-admin-core": "repo://peanut-admin-core/"
  }
}
