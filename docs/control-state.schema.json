{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "repo://peanut-admin/docs/control-state.schema.json",
  "title": "Peanut Admin private control state",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "revision", "policy_ref", "control", "authorization", "work", "run", "failure", "manual_gates", "resume", "evidence_index"],
  "properties": {
    "schema_version": {"const": 4},
    "revision": {"type": "integer", "minimum": 1},
    "policy_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "root", "commit", "files"],
      "properties": {
        "repository": {"const": "peanut-admin"},
        "root": {"type": "string", "pattern": "^/"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "files": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
      }
    },
    "control": {"$ref": "#/$defs/control"},
    "authorization": {"$ref": "#/$defs/authorization"},
    "work": {"$ref": "#/$defs/work"},
    "run": {"$ref": "#/$defs/run"},
    "failure": {"$ref": "#/$defs/failure"},
    "manual_gates": {"type": "array", "items": {"$ref": "#/$defs/gate"}},
    "resume": {"$ref": "#/$defs/resume"},
    "evidence_index": {"$ref": "#/$defs/evidenceIndex"}
  },
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "control": {"type": "object", "additionalProperties": false, "required": ["owner_task", "writer_task", "epoch"], "properties": {"owner_task": {"$ref": "#/$defs/nonempty"}, "writer_task": {"$ref": "#/$defs/nonempty"}, "epoch": {"type": "integer", "minimum": 1}}},
    "authorization": {"type": "object", "additionalProperties": false, "required": ["decision_ref", "scope_ref", "status", "exclusions"], "properties": {"decision_ref": {"$ref": "#/$defs/nonempty"}, "scope_ref": {"$ref": "#/$defs/nonempty"}, "status": {"enum": ["approved", "blocked", "revoked"]}, "exclusions": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonempty"}}}},
    "work": {"type": "object", "additionalProperties": false, "required": ["id", "repository", "root", "head", "tree", "diff_ref", "claims"], "properties": {"id": {"$ref": "#/$defs/nonempty"}, "repository": {"const": "peanut-admin"}, "root": {"type": "string", "pattern": "^/"}, "head": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "diff_ref": {"$ref": "#/$defs/nonempty"}, "claims": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonempty"}}}},
    "run": {"type": "object", "additionalProperties": false, "required": ["mode", "status", "contract_ref", "preflight_ref", "lease_refs"], "properties": {"mode": {"enum": ["review", "development", "qualification", "release"]}, "status": {"enum": ["ready", "running", "blocked", "complete"]}, "contract_ref": {"$ref": "#/$defs/nonempty"}, "preflight_ref": {"type": ["string", "null"]}, "lease_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonempty"}}}},
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family_id", "diagnoses_used", "reruns_used", "limit", "last_event_ref", "status"],
      "properties": {
        "family_id": {"$ref": "#/$defs/nonempty"},
        "diagnoses_used": {"type": "integer", "minimum": 0},
        "reruns_used": {"type": "integer", "minimum": 0},
        "limit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["diagnoses", "reruns"],
          "properties": {
            "diagnoses": {"type": "integer", "minimum": 0},
            "reruns": {"type": "integer", "minimum": 0}
          }
        },
        "last_event_ref": {"$ref": "#/$defs/nonempty"},
        "status": {"enum": ["available", "exhausted"]}
      }
    },
    "gate": {"type": "object", "additionalProperties": false, "required": ["id", "status", "decision_ref"], "properties": {"id": {"$ref": "#/$defs/nonempty"}, "status": {"enum": ["pending", "approved", "rejected"]}, "decision_ref": {"type": ["string", "null"]}}},
    "resume": {"type": "object", "additionalProperties": false, "required": ["action", "depends_on", "last_operation_ref"], "properties": {"action": {"$ref": "#/$defs/nonempty"}, "depends_on": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonempty"}}, "last_operation_ref": {"type": ["string", "null"]}}},
    "evidenceIndex": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "pattern": "^/"}, "sha256": {"$ref": "#/$defs/sha256"}}}
  }
}
