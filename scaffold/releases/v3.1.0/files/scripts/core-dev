#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
ROOT_DIR="$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)"
CORE_DIR="${PEANUT_ADMIN_CORE_DIR:-$ROOT_DIR/../peanut-admin-core}"
PHP_LINK="$ROOT_DIR/server/vendor/peanut-admin/core"
WEB_LINK="$ROOT_DIR/web/node_modules/@peanut-admin/admin"

die() { printf 'core-dev: %s\n' "$*" >&2; exit 1; }
action="${1:-status}"
[[ $# -le 1 ]] || die 'usage: scripts/core-dev {link|status|unlink|verify}'
CORE_DIR="$(CDPATH= cd -- "$CORE_DIR" 2>/dev/null && pwd)" || die "core checkout not found: $CORE_DIR"
PHP_CORE="$CORE_DIR/packages/php"
WEB_CORE="$CORE_DIR/packages/web"
[[ -f "$PHP_CORE/composer.json" ]] || die "PHP Core package is missing: $PHP_CORE"
[[ -f "$WEB_CORE/package.json" ]] || die "Web Core package is missing: $WEB_CORE"

assert_versions() {
  local required_php required_web actual_php actual_web
  required_php="$(jq -r '.require["peanut-admin/core"] // empty' "$ROOT_DIR/server/composer.json")"
  required_web="$(node -e 'const m=require(process.argv[1]); process.stdout.write(m.dependencies?.["@peanut-admin/admin"] ?? "")' "$ROOT_DIR/web/package.json")"
  actual_php="$(jq -r '.version // empty' "$PHP_CORE/composer.json")"
  actual_web="$(node -e 'const m=require(process.argv[1]); process.stdout.write(m.version ?? "")' "$WEB_CORE/package.json")"
  [[ "$required_php" == "$actual_php" ]] || die "PHP Core version mismatch: application=$required_php core=$actual_php"
  [[ "$required_web" == "$actual_web" ]] || die "Web Core version mismatch: application=$required_web core=$actual_web"
}

assert_versions

case "$action" in
  link)
    "$ROOT_DIR/scripts/local-core-composer" install
    "$ROOT_DIR/scripts/local-core-web" link
    ;;
  status)
    [[ -L "$PHP_LINK" ]] || die "PHP Core is not symlinked: $PHP_LINK"
    [[ "$(realpath "$PHP_LINK")" == "$PHP_CORE" ]] || die 'PHP Core symlink resolves outside selected checkout'
    [[ -L "$WEB_LINK" ]] || die "Web Core is not symlinked: $WEB_LINK"
    [[ "$(realpath "$WEB_LINK")" == "$WEB_CORE" ]] || die 'Web Core symlink resolves outside selected checkout'
    ;;
  unlink)
    if [[ -L "$PHP_LINK" ]]; then
      [[ "$(realpath "$PHP_LINK")" == "$PHP_CORE" ]] || die 'refusing to unlink an unrelated PHP Core path'
      rm "$PHP_LINK"
    fi
    if [[ -L "$WEB_LINK" ]]; then
      [[ "$(realpath "$WEB_LINK")" == "$WEB_CORE" ]] || die 'refusing to unlink an unrelated Web Core path'
      rm "$WEB_LINK"
    fi
    /usr/local/bin/composer install --working-dir="$ROOT_DIR/server" --no-interaction --no-progress --prefer-dist
    if command -v pnpm >/dev/null 2>&1; then
      pnpm --dir "$ROOT_DIR/web" install --frozen-lockfile --ignore-scripts
    else
      npm --prefix "$ROOT_DIR/web" install --package-lock=false --ignore-scripts
    fi
    ;;
  verify)
    if [[ -L "$PHP_LINK" && "$(realpath "$PHP_LINK")" == "$PHP_CORE" ]]; then
      die 'PHP Core local symlink is active; release verification requires fixed dependency'
    fi
    if [[ -L "$WEB_LINK" && "$(realpath "$WEB_LINK")" == "$WEB_CORE" ]]; then
      die 'Web Core local symlink is active; release verification requires fixed dependency'
    fi
    composer validate --no-check-publish --working-dir="$ROOT_DIR/server" >/dev/null
    php "$ROOT_DIR/scripts/build-application-template-inventory" --check >/dev/null
    ;;
  *) die 'usage: scripts/core-dev {link|status|unlink|verify}' ;;
esac

printf 'core-dev: %s php=%s web=%s\n' "$action" "$(jq -r '.version' "$PHP_CORE/composer.json")" "$(node -e 'process.stdout.write(require(process.argv[1]).version)' "$WEB_CORE/package.json")"
