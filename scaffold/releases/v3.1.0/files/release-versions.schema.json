{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://peanut-admin.example/schemas/release-versions.v2.json",
  "title": "Scaffold Product Token release versions v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol",
    "source_product_version",
    "instance_version",
    "scaffold_template",
    "generated_instance_default",
    "core_php",
    "core_web"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "protocol": { "const": "peanut.release-versions.v2" },
    "source_product_version": { "$ref": "#/$defs/semver" },
    "instance_version": { "oneOf": [{ "$ref": "#/$defs/semver" }, { "type": "null" }] },
    "scaffold_template": { "$ref": "#/$defs/semver" },
    "generated_instance_default": { "$ref": "#/$defs/semver" },
    "core_php": { "$ref": "#/$defs/semver" },
    "core_web": { "$ref": "#/$defs/semver" }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    }
  }
}
