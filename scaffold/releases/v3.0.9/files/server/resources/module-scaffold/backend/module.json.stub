{
  "schema_version": 1,
  "key": ${MODULE_KEY_JSON},
  "name": ${NAME_JSON},
  "description": ${DESCRIPTION_JSON},
  "version": "1.0.0",
  "kernel_constraint": "^1.0",
  "license": "proprietary",
  "php_package": ${PHP_PACKAGE_JSON},
  "web_package": ${WEB_PACKAGE_JSON},
  "dependencies": [],
  "lifecycle": {
    "protected": false
  },
  "backend": {
    "provider": ${BACKEND_PROVIDER_JSON},
    "routes": "Http/routes.php",
    "migrations": "Database/Migrations",
    "menus": "Resources/menus.json",
    "permissions": "Resources/permissions.json",
    "setting_definitions": "Resources/setting-definitions.json"
  },
  "frontend": {
    "entry": ${FRONTEND_ENTRY_JSON}
  },
  "database": {
    "owned_tables": []
  },
  "contracts": {
    "exports": [${COMMANDS_CONTRACT_JSON}],
    "events": []
  },
  "tenant": {
    "enableable": true,
    "disable_behavior": "reject_new_operations",
    "requires": []
  }
}
