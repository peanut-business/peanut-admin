#!/bin/sh

set -eu

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
test_dir=$(mktemp -d "${TMPDIR:-/tmp}/peanut-runtime-contract.XXXXXX")
env_file="$test_dir/stack.env"
trap 'rm -rf "$test_dir"' EXIT INT TERM

cat > "$env_file" <<'EOF'
APP_DEBUG=true
DEPLOYMENT_MODE=standalone
DB_USER=peanut_admin_development
DB_PASS=contract-only-placeholder
ADMIN_INITIAL_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=ContractOnly123
PHP_PORT=22180
VITE_PORT=22181
MOBILE_PORT=22182
REDIS_PORT=22184
PC_PORT=22185
DOCS_PORT=22186
DEV_HTTP_PORT=22187
HTTP_PORT=22190
EOF

urls=$(PEANUT_LOCAL_ENV_FILE="$env_file" "$repo_dir/scripts/local-stack.sh" urls)
for expected in 22180 22181 22182 22185 22186 22187 22190; do
    printf '%s\n' "$urls" | grep -q ":$expected/" || {
        printf 'missing custom port in URL output: %s\n' "$expected" >&2
        exit 1
    }
done

for pair in PHP_PORT=22180 VITE_PORT=22181 MOBILE_PORT=22182 REDIS_PORT=22184 PC_PORT=22185 DOCS_PORT=22186 DEV_HTTP_PORT=22187 HTTP_PORT=22190; do
    grep -qx "$pair" "$env_file" || {
        printf 'ensure_env overwrote custom listener: %s\n' "$pair" >&2
        exit 1
    }
done

set -a
# shellcheck disable=SC1090 -- isolated contract environment.
. "$env_file"
set +a
compose=$(docker compose --profile redis --env-file "$env_file" -f "$repo_dir/deploy/docker-compose.dev.yml" config)
for mapping in 'host_ip: 127.0.0.1' 'published: "22181"' 'published: "22182"' 'published: "22184"' 'published: "22185"' 'published: "22186"' 'published: "22187"' host.docker.internal:22180; do
    printf '%s\n' "$compose" | grep -q "$mapping" || {
        printf 'Compose config is missing custom mapping: %s\n' "$mapping" >&2
        exit 1
    }
done

production_compose=$(PEANUT_DEPLOYMENT_TARGET=local-production-preview \
    docker compose --env-file "$env_file" -f "$repo_dir/deploy/docker-compose.prod.yml" config)
printf '%s\n' "$production_compose" | grep -q 'published: "22190"' || {
    printf 'production-preview Compose config lost custom HTTP_PORT\n' >&2
    exit 1
}
grep -q '\${HTTP_PORT:-18092}:80' "$repo_dir/deploy/docker-compose.prod.yml" || {
    printf 'production deployment default is no longer scoped to 18092\n' >&2
    exit 1
}

for expectation in "web 22181 22180" "pc 22185 22180" "mobile 22182 22180" "docs 22186"; do
    set -- $expectation
    component=$1
    listen_port=$2
    api_port=${3:-}
    case "$component" in
        mobile) component_dir=uniapp ;;
        docs) component_dir=docs-site ;;
        *) component_dir=$component ;;
    esac
    client_output=$(
        cd "$repo_dir/$component_dir"
        PEANUT_LOCAL_ENV_FILE="$env_file" PEANUT_LOCAL_CLIENT_DRY_RUN=1 \
            "$repo_dir/scripts/local-client-dev" "$component"
    )
    printf '%s\n' "$client_output" | grep -q "listen_port=$listen_port" || {
        printf 'local %s command lost custom listen port %s\n' "$component" "$listen_port" >&2
        exit 1
    }
    if [ -n "$api_port" ]; then
        printf '%s\n' "$client_output" | grep -q "api_origin=http://127.0.0.1:$api_port" || {
            printf 'local %s command lost custom API port %s\n' "$component" "$api_port" >&2
            exit 1
        }
    fi
done

printf 'local runtime override contract passed\n'
