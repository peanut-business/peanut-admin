#!/bin/sh

set -eu

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
env_file=${PEANUT_LOCAL_ENV_FILE:-"$repo_dir/.local/stack.env"}
registry="$repo_dir/scripts/project-resource-registry"
component=${1:-}
[ -n "$component" ] || { printf 'Usage: %s {web|pc|mobile|docs} [-- extra args]\n' "$0" >&2; exit 2; }
shift
[ "${1:-}" != "--" ] || shift

defaults=$(mktemp "${TMPDIR:-/tmp}/peanut-client-env.XXXXXX")
trap 'rm -f "$defaults"' EXIT INT TERM
"$registry" local-stack-env --deployment-target local-development > "$defaults"
set -a
# shellcheck disable=SC1090 -- values are validated by project-resource-registry.
. "$defaults"
if [ -f "$env_file" ]; then
    # shellcheck disable=SC1090 -- user-selected gitignored local environment.
    . "$env_file"
fi
set +a

export VITE_API_PROXY_TARGET="http://127.0.0.1:$PHP_PORT"
export NUXT_DEV_PROXY_TARGET="http://127.0.0.1:$PHP_PORT/api"
export NUXT_DEV_PROXY_ORIGIN="http://127.0.0.1:$PHP_PORT"

case "$component" in
    web)
        [ "${PEANUT_LOCAL_CLIENT_DRY_RUN:-0}" != 1 ] || {
            printf 'component=web listen_port=%s api_origin=%s\n' "$VITE_PORT" "$VITE_API_PROXY_TARGET"
            exit 0
        }
        exec node node_modules/vite/bin/vite.js --config ./config/vite.config.dev.ts --host 127.0.0.1 --port "$VITE_PORT" "$@"
        ;;
    pc)
        [ "${PEANUT_LOCAL_CLIENT_DRY_RUN:-0}" != 1 ] || {
            printf 'component=pc listen_port=%s api_origin=%s\n' "$PC_PORT" "$NUXT_DEV_PROXY_ORIGIN"
            exit 0
        }
        exec node node_modules/nuxt/bin/nuxt.mjs dev --host 127.0.0.1 --port "$PC_PORT" "$@"
        ;;
    mobile)
        [ "${PEANUT_LOCAL_CLIENT_DRY_RUN:-0}" != 1 ] || {
            printf 'component=mobile listen_port=%s api_origin=%s\n' "$MOBILE_PORT" "$VITE_API_PROXY_TARGET"
            exit 0
        }
        exec node node_modules/@dcloudio/vite-plugin-uni/bin/uni.js --host 127.0.0.1 --port "$MOBILE_PORT" "$@"
        ;;
    docs)
        [ "${PEANUT_LOCAL_CLIENT_DRY_RUN:-0}" != 1 ] || {
            printf 'component=docs listen_port=%s\n' "$DOCS_PORT"
            exit 0
        }
        exec node node_modules/vitepress/bin/vitepress.js dev . --host 127.0.0.1 --port "$DOCS_PORT" "$@"
        ;;
    *) printf 'Unsupported local client: %s\n' "$component" >&2; exit 2 ;;
esac
