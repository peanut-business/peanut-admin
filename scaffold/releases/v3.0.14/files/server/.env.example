# Scaffold Product Token backend configuration. Copy to server/.env. This is the only
# source for PHP application, database, identity and Tenant/Platform settings.
APP_ENV=production
APP_DEBUG=false
PEANUT_DEPLOYMENT_TARGET=production
PEANUT_DATABASE_RESOURCE_ID=peanut-admin-production-bundled-mysql84
# Optional identity assertions emitted by the resource selector.
PEANUT_DATABASE_ENDPOINT_ID=
PEANUT_DATABASE_CONSUMER=container

# Bundled MySQL profile service name. Replace for an external database.
DB_HOST=mysql
DB_PORT=3306
DB_NAME=peanut_admin
DB_USER=peanut_admin
DB_PASS=
DB_PREFIX=pa_
# Only required when using the optional bundled-db profile.
DB_ROOT_PASS=

# Required. Generate independent stable values; never reuse sample secrets.
JWT_SECRET=
JWT_EXPIRE=7200
ADMIN_TOKEN_EXPIRE=7200
ADMIN_TOKEN_RENEW_BEFORE=1200
ADMIN_PASSWORD_ERROR_TIMES=5
ADMIN_LOGIN_LOCK_MINUTES=5
PEANUT_STORAGE_CREDENTIAL_MASTER_KEY=
TENANT_IDENTIFIER_HMAC_KEY=
PLATFORM_IDENTIFIER_HMAC_KEY=

# Required deployment mode. Use exactly standalone or multi-tenant.
DEPLOYMENT_MODE=standalone
PUBLIC_DEFAULT_TENANT_FALLBACK=true
OWNER_INVITATION_DELIVERY_MODE=auto

# Fresh installation transport. automatic receives initial identities only as
# process environment for the installer command. guided receives them only in
# the authenticated setup request; never persist initial identities here.
PEANUT_INSTALLATION_MODE=automatic
PEANUT_INSTALLATION_SETUP_TOKEN=
PEANUT_INSTALLATION_OFFICIAL_MODULES=

# Required for multi-tenant deployments. Tenant-specific hosts are dynamic.
PLATFORM_HOSTS=
TENANT_ADMIN_HOSTS=

# Optional backend/module runtime settings. Keep overrides here, never in the
# root orchestration environment.
DB_DRIVER=mysql
DB_TYPE=mysql
DB_CHARSET=utf8mb4
ASYNC_SIGNING_KEY=
ASYNC_WORKER_LIMIT=4
DEFAULT_LANG=zh-cn
PROJECT_VERSION=
PEANUT_MODULE_ROOTS=
PEANUT_PLUGIN_LOCK=../plugins.lock
PEANUT_MODULE_KERNEL_VERSION=1.0.0
PEANUT_MODULE_TRUSTED_KEYS_JSON={}
RICH_TEXT_COLLABORATION_URL=
RICH_TEXT_COLLABORATION_SECRET=

# Optional synthetic demo settings. Production deployments normally keep the
# mode disabled and leave the remaining fields empty.
PEANUT_DEMO_MODE=disabled
PEANUT_DEMO_TENANT_A_EMAIL=
PEANUT_DEMO_TENANT_B_EMAIL=
PEANUT_DEMO_SHARED_PASSWORD=
PEANUT_DEMO_TENANT_A_HOST=
PEANUT_DEMO_TENANT_B_HOST=
PEANUT_DEMO_DOCS_URL=
