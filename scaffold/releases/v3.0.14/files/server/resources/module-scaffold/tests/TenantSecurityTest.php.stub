<?php
declare(strict_types=1);

interface TenantSecurityDriver
{
    public function reset(): void;
    public function context(string $tenantCode): mixed;
    public function tenantId(mixed $context): int;
    public function enable(mixed $context): void;
    public function disable(mixed $context): void;
    public function grant(mixed $context): void;
    public function revoke(mixed $context): void;
    /** @param array<string,mixed> $payload @return array{id:int,tenant_id:int} */
    public function create(mixed $context, array $payload): array;
    /** @return list<array{id:int,tenant_id:int}> */
    public function list(mixed $context): array;
    /** @return array{id:int,tenant_id:int}|null */
    public function find(mixed $context, int $id): ?array;
    /** @return array{package_status:string,migration_status:string} */
    public function installWithFailingMigration(): array;
    /** @return array{package_status:string,migration_status:string,replayed:bool} */
    public function retryFailedMigrationWithoutRepair(): array;
    public function cleanup(): void;
}

function moduleTenantExpect(bool $condition, string $message): void
{
    if (!$condition) throw new RuntimeException($message);
}

function moduleTenantRejects(callable $operation, string $errorCode): void
{
    try {
        $operation();
    } catch (Throwable $exception) {
        moduleTenantExpect(str_contains($exception->getMessage(), $errorCode), "Expected {$errorCode}");
        return;
    }
    throw new RuntimeException("Expected {$errorCode} rejection");
}

$driver = require __DIR__ . '/TenantSecurityDriver.php';
moduleTenantExpect($driver instanceof TenantSecurityDriver, 'Tenant security driver contract changed');

try {
    $driver->reset();
    $tenantA = $driver->context('tenant-a');
    $tenantB = $driver->context('tenant-b');
    $driver->enable($tenantA);
    $driver->enable($tenantB);
    $driver->grant($tenantA);
    $driver->grant($tenantB);

    // A forged tenant_id in payload must never replace the trusted TenantContext.
    $recordA = $driver->create($tenantA, [
        'tenant_id' => $driver->tenantId($tenantB),
        'reference' => 'tenant-a-only',
    ]);
    moduleTenantExpect($recordA['tenant_id'] === $driver->tenantId($tenantA), 'forged Tenant ID changed ownership');
    moduleTenantExpect(count($driver->list($tenantA)) === 1, 'Tenant A cannot read its record');
    moduleTenantExpect($driver->list($tenantB) === [], 'Tenant B listed Tenant A data');
    moduleTenantExpect($driver->find($tenantB, $recordA['id']) === null, 'forged resource ID crossed Tenant boundary');

    $driver->revoke($tenantA);
    moduleTenantRejects(
        static fn() => $driver->create($tenantA, ['reference' => 'revoked']),
        'AUTHORIZATION_PERMISSION_DENIED',
    );

    $driver->grant($tenantA);
    $driver->disable($tenantA);
    moduleTenantRejects(
        static fn() => $driver->create($tenantA, ['reference' => 'disabled']),
        'MODULE_TENANT_DISABLED',
    );

    $failed = $driver->installWithFailingMigration();
    moduleTenantExpect($failed['package_status'] !== 'active', 'failed migration activated the Plugin');
    moduleTenantExpect($failed['migration_status'] === 'failed', 'failed migration was not durable');
    $retry = $driver->retryFailedMigrationWithoutRepair();
    moduleTenantExpect($retry['package_status'] !== 'active', 'ambiguous failed migration retry activated the Plugin');
    moduleTenantExpect($retry['migration_status'] === 'failed', 'failed migration evidence was overwritten');
    moduleTenantExpect($retry['replayed'] === false, 'failed migration replayed without an explicit repair');

    echo "MODULE-TENANT-SECURITY-001 passed module=${MODULE_KEY}\n";
} finally {
    $driver->cleanup();
}
