{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://peanut-admin.org/schemas/plugin.schema.json",
  "title": "Scaffold Product Token Plugin Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "key", "version", "source", "composer", "npm", "frontend", "modules"],
  "properties": {
    "schema_version": { "const": 1 },
    "key": { "$ref": "#/$defs/key" },
    "version": { "$ref": "#/$defs/version" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "reference", "sha256"],
      "properties": {
        "type": { "const": "canonical-contents" },
        "reference": { "const": "canonical-plugin-contents-v1" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "composer": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "sha256"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9_.-]+/[a-z0-9_.-]+$" },
          "version": { "$ref": "#/$defs/version" },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "npm": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "integrity"],
        "properties": {
          "name": { "type": "string", "pattern": "^@[a-z0-9_.-]+/[a-z0-9_.-]+$" },
          "version": { "$ref": "#/$defs/version" },
          "integrity": { "type": "string", "pattern": "^sha256-[A-Za-z0-9+/]{43}=$" }
        }
      }
    },
    "frontend": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["client_key", "package", "version", "entry", "sha256"],
        "properties": {
          "client_key": { "type": "string", "minLength": 1, "maxLength": 96 },
          "package": { "type": "string", "minLength": 1, "maxLength": 160 },
          "version": { "$ref": "#/$defs/version" },
          "entry": { "$ref": "#/$defs/relativePath" },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "root"],
        "properties": {
          "key": { "$ref": "#/$defs/key" },
          "root": { "$ref": "#/$defs/relativePath" }
        }
      }
    }
  },
  "$defs": {
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
      "maxLength": 96
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$",
      "maxLength": 32
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
