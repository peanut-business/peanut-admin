#!/usr/bin/env php
<?php
declare(strict_types=1);

use app\common\service\scaffold\ScaffoldUpgradeRunner;

$root = dirname(__DIR__);
require $root . '/scripts/scaffold-runtime/ScaffoldPathGuard.php';
require $root . '/scripts/scaffold-runtime/ScaffoldManifest.php';
require $root . '/scripts/scaffold-runtime/ScaffoldUpgradeLedger.php';
require $root . '/scripts/scaffold-runtime/ScaffoldUpgradeRunner.php';

function usage(): never
{
    fwrite(STDERR, "Usage:\n"
        . "  php scripts/scaffold-upgrade preflight --project-root=<path> --from-manifest=<path> --to-manifest=<path>\n"
        . "  php scripts/scaffold-upgrade apply|verify|recover|rollback --project-root=<path> --plan=<path>\n");
    exit(64);
}

$command = $argv[1] ?? null;
if (!in_array($command, ['preflight', 'apply', 'verify', 'recover', 'rollback'], true)) usage();
$options = [];
foreach (array_slice($argv, 2) as $argument) {
    if (preg_match('/^--(project-root|from-manifest|to-manifest|plan)=(.+)$/D', $argument, $matches) !== 1 || isset($options[$matches[1]])) {
        usage();
    }
    $options[$matches[1]] = $matches[2];
}
$requiredOptions = $command === 'preflight' ? ['project-root', 'from-manifest', 'to-manifest'] : ['project-root', 'plan'];
foreach ($requiredOptions as $required) {
    if (!isset($options[$required]) || !is_string($options[$required]) || $options[$required] === '') {
        usage();
    }
}

try {
    $runner = new ScaffoldUpgradeRunner();
    $result = match ($command) {
        'preflight' => $runner->preflight($options['project-root'], $options['from-manifest'], $options['to-manifest']),
        'apply' => $runner->apply($options['project-root'], $options['plan']),
        'verify' => $runner->verify($options['project-root'], $options['plan']),
        'recover', 'rollback' => $runner->recover($options['project-root'], $options['plan']),
    };
    fwrite(STDOUT, json_encode($result, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR) . "\n");
    exit(($result['status'] ?? null) === 'blocked' ? 2 : 0);
} catch (Throwable $exception) {
    fwrite(STDERR, json_encode([
        'status' => 'error',
        'error' => $exception->getMessage(),
    ], JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR) . "\n");
    exit(1);
}
