#!/usr/bin/env php
<?php
declare(strict_types=1);

use app\common\service\scaffold\ScaffoldUpgradeRunner;

$root = dirname(__DIR__);
require $root . '/server/app/common/service/scaffold/ScaffoldPathGuard.php';
require $root . '/server/app/common/service/scaffold/ScaffoldManifest.php';
require $root . '/server/app/common/service/scaffold/ScaffoldUpgradeLedger.php';
require $root . '/server/app/common/service/scaffold/ScaffoldUpgradeRunner.php';

function usage(): never
{
    fwrite(STDERR, "Usage: php scripts/scaffold-upgrade preflight --project-root=<path> --from-manifest=<path> --to-manifest=<path>\n");
    exit(64);
}

if (($argv[1] ?? null) !== 'preflight') {
    usage();
}
$options = [];
foreach (array_slice($argv, 2) as $argument) {
    if (preg_match('/^--(project-root|from-manifest|to-manifest)=(.+)$/D', $argument, $matches) !== 1) {
        usage();
    }
    $options[$matches[1]] = $matches[2];
}
foreach (['project-root', 'from-manifest', 'to-manifest'] as $required) {
    if (!isset($options[$required]) || !is_string($options[$required]) || $options[$required] === '') {
        usage();
    }
}

try {
    $plan = (new ScaffoldUpgradeRunner())->preflight(
        $options['project-root'],
        $options['from-manifest'],
        $options['to-manifest'],
    );
    fwrite(STDOUT, json_encode($plan, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR) . "\n");
    exit($plan['status'] === 'ready' ? 0 : 2);
} catch (Throwable $exception) {
    fwrite(STDERR, json_encode([
        'status' => 'error',
        'error' => $exception->getMessage(),
    ], JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR) . "\n");
    exit(1);
}
