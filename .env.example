APP_ENV=production
APP_DEBUG=false
HTTP_PORT=18092

# Bundled MySQL profile service name. Replace for an external database.
DB_HOST=mysql
DB_PORT=3306
DB_NAME=peanut_admin
DB_USER=peanut_admin
DB_PASS=replace-with-a-random-database-password
# Required only for a fresh empty-database install. Leave unset on upgrades.
ADMIN_INITIAL_PASSWORD=
# Only required when using the optional bundled-db profile.
MYSQL_ROOT_PASSWORD=replace-with-a-different-random-root-password
JWT_SECRET=replace-with-at-least-32-random-bytes

# Required deployment mode. Use exactly standalone or multi-tenant.
DEPLOYMENT_MODE=standalone
# Stable, independent HMAC material for administrator/Tenant and PlatformOperator
# login identifiers. Use different random values of at least 32 bytes.
TENANT_IDENTIFIER_HMAC_KEY=
PLATFORM_IDENTIFIER_HMAC_KEY=
# Required by fresh install and first migration into the Tenant account model.
ADMIN_INITIAL_EMAIL=
# Required only for a fresh multi-tenant install or first migration. It must not
# equal ADMIN_INITIAL_EMAIL. Leave both platform values unset in standalone mode.
PLATFORM_INITIAL_EMAIL=
PLATFORM_INITIAL_PASSWORD=

PHP_IMAGE=peanut-admin-php:production
NGINX_IMAGE=peanut-admin-nginx:production

# Optional build proxy. The address must be reachable from Docker builder.
# BUILD_HTTP_PROXY=http://docker-builder-visible-host:7890
# BUILD_HTTPS_PROXY=http://docker-builder-visible-host:7890
# BUILD_ALL_PROXY=http://docker-builder-visible-host:7890
# BUILD_NO_PROXY=localhost,127.0.0.1,::1
